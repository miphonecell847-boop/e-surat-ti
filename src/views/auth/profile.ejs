<div class="max-w-2xl mx-auto bg-slate-900 border border-slate-800 rounded-3xl p-8 shadow-xl space-y-6">
    <div class="flex items-center gap-4 border-b border-slate-800 pb-6">
        <div class="w-16 h-16 rounded-full bg-indigo-600/20 border border-indigo-500/30 text-indigo-400 flex items-center justify-center text-2xl font-bold">
            <%= user ? user.username.substring(0, 2).toUpperCase() : 'US' %>
        </div>
        <div>
            <h2 class="text-xl font-bold text-white"><%= user ? user.username : 'User' %></h2>
            <p class="text-xs text-slate-400"><%= user ? user.email : '-' %></p>
            <span class="inline-block mt-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 uppercase tracking-wide">
                <%= user ? user.role.replace('_', ' ') : 'Role' %>
            </span>
        </div>
    </div>

    <div class="space-y-4">
        <h3 class="font-bold text-xs uppercase tracking-wider text-slate-400">Detail Informasi Akun</h3>
        <div class="grid grid-cols-2 gap-4 text-xs">
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                <span class="text-slate-500 block mb-1">Username</span>
                <span class="font-semibold text-white"><%= user.username %></span>
            </div>
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                <span class="text-slate-500 block mb-1">Email System</span>
                <span class="font-semibold text-white"><%= user.email %></span>
            </div>
        </div>
    </div>
</div>
