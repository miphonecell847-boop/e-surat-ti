<div class="max-w-3xl mx-auto space-y-6">
    <!-- Header Page -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Form Pengajuan Surat & SK Administrasi TA</h2>
            <p class="text-xs text-slate-500 mt-1">Pilih jenis surat yang ingin diajukan. Identitas dan Perihal otomatis terisi oleh sistem.</p>
        </div>
        <a href="/mahasiswa/daftar-surat" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Daftar Surat
        </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div id="alert-banner-error" class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-600 text-xs flex items-center justify-between gap-3 shadow-sm transition-all duration-500">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-triangle-exclamation text-base shrink-0"></i>
                <span class="font-bold"><%= error %></span>
            </div>
            <button type="button" onclick="dismissAlert('alert-banner-error')" class="text-rose-500 hover:text-rose-700 p-1">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div id="alert-banner-success" class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 text-xs flex items-center justify-between gap-3 shadow-sm transition-all duration-500">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-circle-check text-base shrink-0"></i>
                <span class="font-bold"><%= success %></span>
            </div>
            <button type="button" onclick="dismissAlert('alert-banner-success')" class="text-emerald-600 hover:text-emerald-800 p-1">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>
    <% } %>

    <!-- Read-Only Identity Card (Auto-Fetched from Database) -->
    <div class="bg-gradient-to-r from-blue-900 via-slate-900 to-indigo-950 p-6 rounded-3xl border border-blue-800 text-white shadow-lg space-y-3">
        <div class="flex items-center justify-between border-b border-blue-800/80 pb-3">
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 text-[11px] font-bold rounded-full border border-blue-400/30 uppercase tracking-wider flex items-center gap-1.5">
                <i class="fa-solid fa-id-card text-amber-400"></i> Identitas Pemohon (Otomatis Terisi)
            </span>
            <span class="text-[11px] text-blue-300 font-mono"><%= mhs.nim %></span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div>
                <p class="text-blue-300/80 font-medium text-[11px] uppercase tracking-wider">Nama Mahasiswa</p>
                <p class="font-extrabold text-sm text-white mt-0.5"><%= mhs.nama_lengkap %></p>
            </div>
            <div>
                <p class="text-blue-300/80 font-medium text-[11px] uppercase tracking-wider">NIM / Stambuk</p>
                <p class="font-extrabold text-sm text-amber-300 mt-0.5"><%= mhs.nim %></p>
            </div>
        </div>
        <div class="pt-2 border-t border-blue-800/60">
            <p class="text-blue-300/80 font-medium text-[11px] uppercase tracking-wider">Judul Skripsi / Tugas Akhir</p>
            <p class="font-bold text-xs text-slate-100 mt-1 leading-relaxed"><%= (mhs && mhs.judul_ta && mhs.judul_ta !== 'null' && mhs.judul_ta !== '-') ? mhs.judul_ta : 'Belum Ada Judul Disetujui (Silakan ajukan usulan judul di menu Pengajuan Judul TA)' %></p>
        </div>
    </div>

    <!-- Main Form -->
    <form action="/mahasiswa/buat-surat" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-3xl p-8 space-y-6 shadow-xl">
        
        <!-- Select Jenis Surat -->
        <div>
            <label for="jenis_surat_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Pilih Jenis Surat / SK Resmimu *</label>
            <select id="jenis_surat_id" name="jenis_surat_id" required onchange="toggleFormFields(this)"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 font-bold text-sm text-slate-900 transition">
                <option value="" disabled selected>-- Pilih Jenis Surat / SK --</option>
                <% jenisList.forEach(jenis => { %>
                    <option value="<%= jenis.id %>" data-kode="<%= jenis.kode_surat %>"><%= jenis.nama_surat %> (<%= jenis.kode_surat %>)</option>
                <% }); %>
            </select>
        </div>

        <!-- Dynamic Fields Container -->
        <div id="dynamic-fields-container" class="space-y-5 p-5 bg-slate-50 border border-slate-200 rounded-2xl">
            <h4 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2 flex items-center gap-2">
                <i class="fa-solid fa-list-check text-blue-600"></i> Detail Spesifikasi Informasi Surat
            </h4>

            <!-- 1. Fields for SRT-IZIN-PENELITIAN -->
            <div id="field-srt-izin-penelitian" class="space-y-4 dynamic-section hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nama Instansi / Perusahaan Tujuan *</label>
                    <input type="text" name="tujuan_instansi" placeholder="Contoh: Kepala Dinas Komunikasi dan Informatika Kota Baubau"
                        class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Alamat / Lokasi Instansi *</label>
                    <input type="text" name="alamat_instansi" placeholder="Contoh: Jl. Sultan Dayanu Ikhsanuddin No. 124, Baubau"
                        class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Mulai Penelitian</label>
                        <input type="date" name="tgl_mulai_penelitian" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Selesai Penelitian</label>
                        <input type="date" name="tgl_selesai_penelitian" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                    </div>
                </div>
            </div>

            <!-- 2. Fields for LMBR-PERSETUJUAN-WKT & UND- (Undangan Seminar / Ujian) -->
            <div id="field-seminar-jadwal" class="space-y-4 dynamic-section hidden">
                <div>
                    <label class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1">Jenis Seminar / Ujian *</label>
                    <select name="jenis_seminar" class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-900 focus:outline-none focus:border-blue-600">
                        <option value="Seminar Proposal (Sempro)">Seminar Proposal (Sempro)</option>
                        <option value="Seminar Hasil (Semhas)">Seminar Hasil (Semhas)</option>
                        <option value="Sidang Akhir / Munaqasyah Skripsi (Tutup)">Sidang Akhir / Munaqasyah Skripsi (Tutup)</option>
                    </select>
                </div>

                <!-- Informational Box: Penentuan Jadwal Oleh Dosen & Admin -->
                <div class="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl space-y-2 text-xs">
                    <div class="flex items-center gap-2 text-blue-900 font-extrabold">
                        <i class="fa-solid fa-circle-info text-blue-600 text-sm"></i>
                        <span>Ketentuan Penentuan Jadwal Seminar / Ujian</span>
                    </div>
                    <p class="text-blue-800 leading-relaxed font-medium">
                        Mahasiswa tidak menentukan jadwal ujian (Hari/Tanggal, Waktu, dan Ruangan) pada form ini. 
                        Jadwal resmi akan ditentukan dan disetujui oleh <strong>Dosen Pembimbing</strong>. Pihak Admin (Staff TU) juga dapat memberikan pilihan/saran jadwal ruangan yang tersedia.
                    </p>
                </div>
            </div>

            <!-- 3. Fields for SK-PEMBIMBING-PENGUJI & KARTU-BIMBINGAN -->
            <div id="field-sk-bimbingan" class="space-y-4 dynamic-section hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tahun Akademik / Semester</label>
                    <input type="text" name="tahun_akademik" placeholder="Contoh: 2025/2026 (Genap)" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                </div>
            </div>

            <!-- Default Info text if none selected -->
            <div id="field-default-info" class="p-3 bg-white rounded-xl border border-slate-200 text-xs text-slate-500 italic">
                Pilih jenis surat pada dropdown di atas untuk menampilkan detail isian informasi yang relevan.
            </div>
        </div>

        <!-- File Upload Area (ONLY VISIBLE FOR UNDANGAN SEMINAR PROPOSAL, HASIL, & SIDANG) -->
        <div id="file-upload-container" class="pt-4 border-t border-slate-200 hidden">
            <label for="file_lampiran" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Upload Berkas Lampiran / Naskah Draft Skripsi (PDF) *</label>
            <div class="p-6 border-2 border-dashed border-slate-300 rounded-2xl bg-slate-50 text-center hover:border-blue-500 transition">
                <i class="fa-solid fa-cloud-arrow-up text-3xl text-blue-600 mb-2"></i>
                <p class="text-xs text-slate-800 font-bold">Pilih File PDF Draft Naskah Skripsi / Proposal Ujian</p>
                <p class="text-[10px] text-slate-500 mt-1">Berkas khusus untuk Undangan Seminar/Sidang. Otomatis tersimpan di Google Drive FTI UNIDAYAN. Max 10MB.</p>
                <input type="file" id="file_lampiran" name="file_lampiran" accept=".pdf" class="mt-4 text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white hover:file:bg-blue-600 cursor-pointer">
            </div>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 text-white font-extrabold rounded-xl text-sm shadow-lg shadow-blue-700/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane text-amber-400"></i> Kirim Pengajuan Surat / SK
        </button>
    </form>
</div>

<script>
    function toggleFormFields(selectEl) {
        const selectedOption = selectEl.options[selectEl.selectedIndex];
        const kode = selectedOption ? selectedOption.getAttribute('data-kode') : '';
        const uploadContainer = document.getElementById('file-upload-container');
        const fileInput = document.getElementById('file_lampiran');

        // Hide all dynamic sections
        document.querySelectorAll('.dynamic-section').forEach(el => el.classList.add('hidden'));
        document.getElementById('field-default-info').classList.add('hidden');

        // Check if file upload is required (Only for UND- letters like Sempro, Semhas, Sidang)
        if (kode.startsWith('UND-')) {
            uploadContainer.classList.remove('hidden');
            fileInput.required = true;
        } else {
            uploadContainer.classList.add('hidden');
            fileInput.required = false;
        }

        if (kode === 'SRT-IZIN-PENELITIAN') {
            document.getElementById('field-srt-izin-penelitian').classList.remove('hidden');
        } else if (kode === 'LMBR-PERSETUJUAN-WKT' || kode.startsWith('UND-')) {
            document.getElementById('field-seminar-jadwal').classList.remove('hidden');
        } else if (kode === 'SK-PEMBIMBING-PENGUJI' || kode === 'KARTU-BIMBINGAN') {
            document.getElementById('field-sk-bimbingan').classList.remove('hidden');
        } else {
            document.getElementById('field-default-info').classList.remove('hidden');
        }
    }

    function dismissAlert(alertId) {
        const el = typeof alertId === 'string' ? document.getElementById(alertId) : alertId;
        if (el) {
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 400);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            const errorAlert = document.getElementById('alert-banner-error');
            const successAlert = document.getElementById('alert-banner-success');
            if (errorAlert) dismissAlert(errorAlert);
            if (successAlert) dismissAlert(successAlert);
        }, 4000);

        if (window.location.search.includes('success') || window.location.search.includes('error')) {
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
        }
    });
</script>
