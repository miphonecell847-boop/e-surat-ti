<div class="max-w-5xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Pengajuan Judul Tugas Akhir / Skripsi</h2>
            <p class="text-xs text-slate-500 mt-1">Formulir pengajuan usulan judul TA dan usulan Dosen Pembimbing 1 & 2.</p>
        </div>
        <a href="/dashboard" class="self-start px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Dashboard
        </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 text-xs flex items-center gap-3">
            <i class="fa-solid fa-triangle-exclamation text-base"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 text-xs flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-base"></i>
            <span><%= success %></span>
        </div>
    <% } %>

    <!-- Form Pengajuan 3 Judul Baru -->
    <form action="/mahasiswa/pengajuan-judul" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-8 shadow-xl">
        <div class="border-b border-slate-200 pb-4">
            <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-book-bookmark text-blue-700"></i> Form Usulan 3 Judul Tugas Akhir / Skripsi
            </h3>
            <p class="text-xs text-slate-500 mt-1">Anda wajib mengisikan 3 usulan judul yang berbeda beserta abstraksi, tujuan, dan manfaat untuk setiap usulan.</p>
        </div>

        <!-- USULAN JUDUL 1 -->
        <div class="bg-slate-50/80 border border-blue-200 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 text-blue-800 font-extrabold text-sm border-b border-blue-100 pb-2">
                <span class="px-2.5 py-0.5 bg-blue-700 text-white rounded-lg text-xs font-black">1</span>
                <span>Usulan Judul Utama (Judul 1) *</span>
            </div>
            <div>
                <label for="judul_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Rencana Judul 1 *</label>
                <textarea id="judul_1" name="judul_1" rows="2" required placeholder="Contoh: Rancang Bangun Sistem E-Surat Administrasi Berbasis Microservices pada UNIDAYAN"
                    class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900 transition"></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="abstraksi_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Abstraksi & Rumusan Masalah 1 *</label>
                    <textarea id="abstraksi_1" name="abstraksi_1" rows="3" required placeholder="Abstraksi singkat dan latar belakang masalah..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                </div>
                <div>
                    <label for="tujuan_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Tujuan Penelitian 1 *</label>
                    <textarea id="tujuan_1" name="tujuan_1" rows="3" required placeholder="Tujuan yang ingin dicapai dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                </div>
                <div>
                    <label for="manfaat_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Manfaat Penelitian 1 *</label>
                    <textarea id="manfaat_1" name="manfaat_1" rows="3" required placeholder="Manfaat praktis dan akademis dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                </div>
            </div>
        </div>

        <!-- USULAN JUDUL 2 -->
        <div class="bg-slate-50/80 border border-emerald-200 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 text-emerald-800 font-extrabold text-sm border-b border-emerald-100 pb-2">
                <span class="px-2.5 py-0.5 bg-emerald-700 text-white rounded-lg text-xs font-black">2</span>
                <span>Usulan Judul Alternatif (Judul 2) *</span>
            </div>
            <div>
                <label for="judul_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Rencana Judul 2 *</label>
                <textarea id="judul_2" name="judul_2" rows="2" required placeholder="Contoh: Analisis Sentimen Opini Publik Menggunakan Algoritma Support Vector Machine"
                    class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-emerald-600 text-xs font-bold text-slate-900 transition"></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="abstraksi_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Abstraksi & Rumusan Masalah 2 *</label>
                    <textarea id="abstraksi_2" name="abstraksi_2" rows="3" required placeholder="Abstraksi singkat dan latar belakang masalah..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-emerald-600"></textarea>
                </div>
                <div>
                    <label for="tujuan_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Tujuan Penelitian 2 *</label>
                    <textarea id="tujuan_2" name="tujuan_2" rows="3" required placeholder="Tujuan yang ingin dicapai dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-emerald-600"></textarea>
                </div>
                <div>
                    <label for="manfaat_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Manfaat Penelitian 2 *</label>
                    <textarea id="manfaat_2" name="manfaat_2" rows="3" required placeholder="Manfaat praktis dan akademis dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-emerald-600"></textarea>
                </div>
            </div>
        </div>

        <!-- USULAN JUDUL 3 -->
        <div class="bg-slate-50/80 border border-purple-200 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 text-purple-800 font-extrabold text-sm border-b border-purple-100 pb-2">
                <span class="px-2.5 py-0.5 bg-purple-700 text-white rounded-lg text-xs font-black">3</span>
                <span>Usulan Judul Cadangan (Judul 3) *</span>
            </div>
            <div>
                <label for="judul_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Rencana Judul 3 *</label>
                <textarea id="judul_3" name="judul_3" rows="2" required placeholder="Contoh: Penerapan Internet of Things (IoT) pada Monitoring Kualitas Air Tambak Garam"
                    class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-purple-600 text-xs font-bold text-slate-900 transition"></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="abstraksi_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Abstraksi & Rumusan Masalah 3 *</label>
                    <textarea id="abstraksi_3" name="abstraksi_3" rows="3" required placeholder="Abstraksi singkat dan latar belakang masalah..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600"></textarea>
                </div>
                <div>
                    <label for="tujuan_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Tujuan Penelitian 3 *</label>
                    <textarea id="tujuan_3" name="tujuan_3" rows="3" required placeholder="Tujuan yang ingin dicapai dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600"></textarea>
                </div>
                <div>
                    <label for="manfaat_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Manfaat Penelitian 3 *</label>
                    <textarea id="manfaat_3" name="manfaat_3" rows="3" required placeholder="Manfaat praktis dan akademis dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600"></textarea>
                </div>
            </div>
        </div>

        <!-- Selection Usulan Pembimbing 1 & Pembimbing 2 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div>
                <label for="dosen_pembimbing_1_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Usulan Dosen Pembimbing 1 (Utama) *</label>
                <select id="dosen_pembimbing_1_id" name="dosen_pembimbing_1_id" required
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                    <option value="" disabled selected>-- Pilih Dosen Pembimbing 1 --</option>
                    <% dosenList.forEach(dosen => { %>
                        <option value="<%= dosen.id %>"><%= dosen.nama_dosen %> (<%= dosen.jabatan || 'Dosen' %>)</option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label for="dosen_pembimbing_2_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Usulan Dosen Pembimbing 2 (Pendamping) *</label>
                <select id="dosen_pembimbing_2_id" name="dosen_pembimbing_2_id" required
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                    <option value="" disabled selected>-- Pilih Dosen Pembimbing 2 --</option>
                    <% dosenList.forEach(dosen => { %>
                        <option value="<%= dosen.id %>"><%= dosen.nama_dosen %> (<%= dosen.jabatan || 'Dosen' %>)</option>
                    <% }); %>
                </select>
            </div>
        </div>

        <!-- Berkas Proposal PDF -->
        <div>
            <label for="file_proposal" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Upload Draft Proposal Skripsi / Outine Penelitian (PDF)</label>
            <div class="p-4 border-2 border-dashed border-slate-300 rounded-2xl bg-slate-50 text-center hover:border-blue-500 transition">
                <input type="file" id="file_proposal" name="file_proposal" accept=".pdf" class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white cursor-pointer">
            </div>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 text-white font-extrabold rounded-xl text-xs shadow-lg transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane text-amber-400"></i> Kirim Usulan 3 Judul TA
        </button>
    </form>

    <!-- Riwayat Pengajuan Judul -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-4">
        <h3 class="text-sm font-black text-slate-900 border-b border-slate-200 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-clock-rotate-left text-amber-500"></i> Riwayat Status Pengajuan Judul Saya
        </h3>

        <% if (listJudul && listJudul.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-100 uppercase text-slate-500 font-extrabold border-b border-slate-200">
                        <tr>
                            <th class="p-3">Judul TA</th>
                            <th class="p-3">Usulan Pembimbing</th>
                            <th class="p-3">Status Verifikasi</th>
                            <th class="p-3">Kesediaan Dosen</th>
                            <th class="p-3">Catatan / Feedback</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 font-medium">
                        <% listJudul.forEach(item => { %>
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 font-semibold text-slate-900 max-w-sm leading-relaxed space-y-1.5">
                                    <div class="p-2 rounded-lg bg-blue-50 border border-blue-100 text-[11px] <%= item.status === 'diterima' && (item.judul_disetujui_nomor === 1 || !item.judul_disetujui_nomor) ? 'ring-2 ring-emerald-500 font-extrabold' : '' %>">
                                        <span class="font-extrabold text-blue-700">1:</span> <%= item.judul_1 || item.judul_ta %>
                                    </div>
                                    <% if (item.judul_2) { %>
                                        <div class="p-2 rounded-lg bg-emerald-50 border border-emerald-100 text-[11px] <%= item.status === 'diterima' && item.judul_disetujui_nomor === 2 ? 'ring-2 ring-emerald-500 font-extrabold' : '' %>">
                                            <span class="font-extrabold text-emerald-700">2:</span> <%= item.judul_2 %>
                                        </div>
                                    <% } %>
                                    <% if (item.judul_3) { %>
                                        <div class="p-2 rounded-lg bg-purple-50 border border-purple-100 text-[11px] <%= item.status === 'diterima' && item.judul_disetujui_nomor === 3 ? 'ring-2 ring-emerald-500 font-extrabold' : '' %>">
                                            <span class="font-extrabold text-purple-700">3:</span> <%= item.judul_3 %>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="p-3 text-slate-700 space-y-1">
                                    <p><strong class="text-slate-900">P1:</strong> <%= item.pembimbing_1_nama %></p>
                                    <p><strong class="text-slate-900">P2:</strong> <%= item.pembimbing_2_nama %></p>
                                </td>
                                <td class="p-3">
                                    <% if (item.status === 'pending_tu') { %>
                                        <span class="px-2.5 py-1 rounded-full bg-slate-200 text-slate-800 text-[10px] font-bold">Verifikasi TU</span>
                                    <% } else if (item.status === 'pending_sekprodi') { %>
                                        <span class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold">Validasi Sekprodi</span>
                                    <% } else if (item.status === 'pending_kaprodi') { %>
                                        <span class="px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold">Otorisasi Kaprodi</span>
                                    <% } else if (item.status === 'diterima') { %>
                                        <span class="px-2.5 py-1 rounded-full bg-emerald-600 text-white text-[10px] font-bold">DITERIMA</span>
                                    <% } else if (item.status === 'revisi') { %>
                                        <span class="px-2.5 py-1 rounded-full bg-amber-500 text-slate-950 text-[10px] font-bold">REVISI</span>
                                    <% } else { %>
                                        <span class="px-2.5 py-1 rounded-full bg-rose-600 text-white text-[10px] font-bold">DITOLAK</span>
                                    <% } %>
                                </td>
                                <td class="p-3 space-y-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] text-slate-500 font-bold">P1:</span>
                                        <% if (item.pembimbing_1_status === 'bersedia') { %>
                                            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[9px] font-bold">BERSEDIA</span>
                                        <% } else if (item.pembimbing_1_status === 'menolak') { %>
                                            <span class="px-2 py-0.5 rounded bg-rose-100 text-rose-800 text-[9px] font-bold">MENOLAK</span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-bold">PENDING</span>
                                        <% } %>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] text-slate-500 font-bold">P2:</span>
                                        <% if (item.pembimbing_2_status === 'bersedia') { %>
                                            <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[9px] font-bold">BERSEDIA</span>
                                        <% } else if (item.pembimbing_2_status === 'menolak') { %>
                                            <span class="px-2 py-0.5 rounded bg-rose-100 text-rose-800 text-[9px] font-bold">MENOLAK</span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-bold">PENDING</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="p-3 text-slate-600 text-[11px]">
                                    <%= item.catatan_kaprodi || item.catatan_sekprodi || item.catatan_tu || '-' %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-xs text-slate-500 text-center py-6">Belum ada pengajuan judul TA. Gunakan form di atas untuk mengajukan judul baru.</p>
        <% } %>
    </div>
</div>
