<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-white">Review Pengajuan Surat Mahasiswa</h2>
            <p class="text-xs text-slate-400 mt-1">Status Disposisi Saat Ini: <span class="font-bold text-amber-400 uppercase"><%= pengajuan.status.replace(/_/g, ' ') %></span></p>
        </div>
        <a href="/dosen/dashboard" class="px-4 py-2 bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-300 text-xs font-semibold rounded-xl transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Inbox
        </a>
    </div>

    <!-- Mahasiswa & Surat Information -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Identitas Mahasiswa</span>
            <h3 class="text-base font-bold text-white"><%= pengajuan.mhs_nama %></h3>
            <p class="text-xs text-indigo-400 font-mono">NIM: <%= pengajuan.mhs_nim %> | Angkatan <%= pengajuan.mhs_angkatan %></p>
            <p class="text-xs text-slate-400 mt-2">Judul TA: "<%= pengajuan.mhs_judul_ta || '-' %>"</p>
        </div>

        <div class="space-y-3 border-t md:border-t-0 md:border-l border-slate-800 pt-4 md:pt-0 md:pl-6">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Jenis Surat</span>
                <p class="text-sm font-bold text-white"><%= pengajuan.nama_surat %></p>
                <p class="text-xs text-indigo-400 font-mono"><%= pengajuan.kode_surat %></p>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Perihal</span>
                <p class="text-xs text-slate-200"><%= pengajuan.perihal %></p>
            </div>
        </div>
    </div>

    <!-- Google Drive Attachments Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl">
        <h3 class="font-bold text-sm text-white mb-4 border-b border-slate-800 pb-3">Berkas Dokumen Pendukung (Google Drive)</h3>
        <% if (docs && docs.length > 0) { %>
            <div class="space-y-3">
                <% docs.forEach(doc => { %>
                    <div class="p-4 bg-slate-950/60 rounded-2xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-file-pdf text-red-400 text-2xl"></i>
                            <div>
                                <h4 class="text-xs font-bold text-white"><%= doc.nama_file_original %></h4>
                                <p class="text-[10px] text-slate-400 uppercase">Kategori: <%= doc.kategori_berkas.replace(/_/g, ' ') %></p>
                            </div>
                        </div>
                        <a href="<%= doc.web_view_link %>" target="_blank" class="px-4 py-2 bg-indigo-600/10 border border-indigo-500/20 text-indigo-400 hover:bg-indigo-600/20 rounded-xl text-xs font-semibold transition">
                            <i class="fa-brands fa-google-drive mr-1"></i> Buka File
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="text-xs text-slate-500">Tidak ada lampiran berkas yang diunggah.</p>
        <% } %>
    </div>

    <!-- Action Review Form -->
    <form action="/dosen/review/<%= pengajuan.id %>" method="POST" class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-5">
        <h3 class="font-bold text-sm text-white border-b border-slate-800 pb-3 flex items-center justify-between">
            <span>Keputusan Approval & Konfirmasi Dosen Pembimbing</span>
            <% if (pengajuan.nomor_surat) { %>
                <span class="text-xs font-mono bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 px-3 py-1 rounded-lg">No. Surat: <%= pengajuan.nomor_surat %></span>
            <% } %>
        </h3>

        <% if (pengajuan.kode_surat && (pengajuan.kode_surat.startsWith('UND-') || pengajuan.kode_surat.includes('UNDANGAN') || pengajuan.kode_surat === 'LMBR-PERSETUJUAN-WKT')) { 
            const sugTgl = (dinamisObj && dinamisObj.tanggal_ujian) ? dinamisObj.tanggal_ujian : new Date().toISOString().split('T')[0];
            const sugJamMulai = (dinamisObj && dinamisObj.jam_mulai) ? dinamisObj.jam_mulai : '09:00';
            const sugJamSelesai = (dinamisObj && dinamisObj.jam_selesai) ? dinamisObj.jam_selesai : '11:00';
            const sugRuangan = (dinamisObj && (dinamisObj.ruangan || dinamisObj.bertempat_di)) ? (dinamisObj.ruangan || dinamisObj.bertempat_di) : 'Ruang Ujian & Seminar TI';
        %>
            <!-- Panel Konfirmasi & Penetapan Jadwal Ujian oleh Dosen Pembimbing -->
            <div class="p-6 bg-gradient-to-r from-amber-500/10 via-slate-900 to-indigo-500/10 border border-amber-500/30 rounded-3xl space-y-5">
                <div class="flex items-center justify-between border-b border-amber-500/20 pb-3">
                    <div class="flex items-center gap-2 text-amber-300 font-bold text-xs">
                        <i class="fa-solid fa-calendar-check text-sm text-amber-400"></i>
                        <span>Penetapan Jadwal Pelaksanaan Ujian (Oleh Dosen Pembimbing)</span>
                    </div>
                    <span class="px-2.5 py-1 bg-amber-500/20 text-amber-300 text-[10px] font-extrabold rounded-lg border border-amber-500/40 uppercase tracking-wider">
                        Otorisasi Pembimbing
                    </span>
                </div>

                <!-- Admin Recommendation Highlight Card -->
                <div class="p-4 bg-slate-950/80 border border-amber-500/30 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs shadow-inner">
                    <div class="space-y-1">
                        <span class="text-[10px] font-extrabold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fa-solid fa-lightbulb"></i> Usulan / Saran Jadwal dari Admin (Staff TU):
                        </span>
                        <p class="font-bold text-slate-200">
                            Tanggal: <span class="text-amber-300 font-mono"><%= sugTgl %></span> | Jam: <span class="text-amber-300 font-mono"><%= sugJamMulai %> - <%= sugJamSelesai %> WITA</span> | Ruang: <span class="text-white"><%= sugRuangan %></span>
                        </p>
                    </div>
                    <button type="button" onclick="useAdminSuggestion('<%= sugTgl %>', '<%= sugJamMulai %>', '<%= sugJamSelesai %>', '<%= sugRuangan.replace(/'/g, "\\'") %>')" 
                        class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl text-xs font-black transition shrink-0 flex items-center gap-1.5 shadow-md shadow-amber-500/20">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Gunakan Saran Admin
                    </button>
                </div>

                <!-- Input Form Detail -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-2 border-t border-amber-500/20">
                    <div>
                        <label for="dosen_tanggal_ujian" class="block font-bold text-slate-300 mb-1 flex items-center justify-between">
                            <span>Tanggal Ujian / Seminar *</span>
                            <span class="text-[10px] text-amber-400 font-normal">Klik untuk Buka Kalender 📅</span>
                        </label>
                        <div class="relative">
                            <input type="date" id="dosen_tanggal_ujian" name="tanggal_ujian" required value="<%= sugTgl %>"
                                onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-bold focus:outline-none focus:border-amber-400 cursor-pointer pr-10 [color-scheme:dark]">
                            <button type="button" onclick="const el=document.getElementById('dosen_tanggal_ujian'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-400 hover:text-amber-300 p-1">
                                <i class="fa-solid fa-calendar-days text-sm"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label for="dosen_ruangan" class="block font-bold text-slate-300 mb-1">Ruangan / Tempat Ujian *</label>
                        <input type="text" id="dosen_ruangan" name="ruangan" required value="<%= sugRuangan %>"
                            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-bold focus:outline-none focus:border-amber-400">
                    </div>
                    <div>
                        <label for="dosen_jam_mulai" class="block font-bold text-slate-300 mb-1 flex items-center justify-between">
                            <span>Jam Mulai Ujian *</span>
                            <span class="text-[10px] text-amber-400 font-normal">Klik untuk Buka Jam ⏰</span>
                        </label>
                        <div class="relative">
                            <input type="time" id="dosen_jam_mulai" name="jam_mulai" required value="<%= sugJamMulai %>"
                                onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-bold focus:outline-none focus:border-amber-400 cursor-pointer pr-10 [color-scheme:dark]">
                            <button type="button" onclick="const el=document.getElementById('dosen_jam_mulai'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-400 hover:text-amber-300 p-1">
                                <i class="fa-solid fa-clock text-sm"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label for="dosen_jam_selesai" class="block font-bold text-slate-300 mb-1 flex items-center justify-between">
                            <span>Jam Selesai Ujian *</span>
                            <span class="text-[10px] text-amber-400 font-normal">Klik untuk Buka Jam ⏰</span>
                        </label>
                        <div class="relative">
                            <input type="time" id="dosen_jam_selesai" name="jam_selesai" required value="<%= sugJamSelesai %>"
                                onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-100 font-bold focus:outline-none focus:border-amber-400 cursor-pointer pr-10 [color-scheme:dark]">
                            <button type="button" onclick="const el=document.getElementById('dosen_jam_selesai'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-400 hover:text-amber-300 p-1">
                                <i class="fa-solid fa-clock text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <div>
            <label for="catatan_revisi" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Catatan Review / Catatan Revisi (Opsional)</label>
            <textarea id="catatan_revisi" name="catatan_revisi" rows="3" placeholder="Masukkan catatan atau instruksi perbaikan jika ada..."
                class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-indigo-500 text-sm text-slate-100 placeholder-slate-500 transition"></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
            <button type="submit" name="action" value="approve" class="w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold rounded-xl text-xs transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-clock-check text-amber-300"></i> <%= (pengajuan.kode_surat && (pengajuan.kode_surat.startsWith('UND-') || pengajuan.kode_surat.includes('UNDANGAN') || pengajuan.kode_surat === 'LMBR-PERSETUJUAN-WKT')) ? 'ACC & Simpan Respon Jam Ujian' : 'ACC & Terbitkan Surat' %>
            </button>
            <button type="submit" name="action" value="revision" class="w-full sm:w-auto px-6 py-3 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-amber-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-pen-to-square"></i> Minta Revisi
            </button>
            <button type="submit" name="action" value="reject" class="w-full sm:w-auto px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-red-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-xmark"></i> Tolak Pengajuan
            </button>
        </div>
    </form>
</div>

<script>
    function useAdminSuggestion(tgl, jMulai, jSelesai, ruang) {
        if (document.getElementById('dosen_tanggal_ujian')) document.getElementById('dosen_tanggal_ujian').value = tgl;
        if (document.getElementById('dosen_jam_mulai')) document.getElementById('dosen_jam_mulai').value = jMulai;
        if (document.getElementById('dosen_jam_selesai')) document.getElementById('dosen_jam_selesai').value = jSelesai;
        if (document.getElementById('dosen_ruangan')) document.getElementById('dosen_ruangan').value = ruang;
    }

    function setDosenDateOption(offsetDays) {
        const d = new Date();
        if (offsetDays === 'next_monday') {
            const day = d.getDay();
            const diff = d.getDate() + (day === 0 ? 1 : 8 - day);
            d.setDate(diff);
        } else if (offsetDays === 'next_friday') {
            const day = d.getDay();
            const diff = d.getDate() + (day <= 5 ? 5 - day : 12 - day);
            d.setDate(diff);
        } else {
            d.setDate(d.getDate() + parseInt(offsetDays, 10));
        }
        if (document.getElementById('dosen_tanggal_ujian')) {
            document.getElementById('dosen_tanggal_ujian').value = d.toISOString().split('T')[0];
        }
    }

    function setDosenTimeSession(start, end) {
        if (document.getElementById('dosen_jam_mulai')) document.getElementById('dosen_jam_mulai').value = start;
        if (document.getElementById('dosen_jam_selesai')) document.getElementById('dosen_jam_selesai').value = end;
    }

    function setDosenRoomOption(roomName) {
        if (document.getElementById('dosen_ruangan')) document.getElementById('dosen_ruangan').value = roomName;
    }
</script>
