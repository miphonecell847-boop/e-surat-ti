<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'E-Surat Administrasi TA' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="h-full flex flex-col md:flex-row overflow-hidden bg-slate-950">

    <!-- Mobile Header -->
    <header class="md:hidden h-16 bg-slate-900 border-b border-slate-800 px-4 flex items-center justify-between shrink-0">
        <a href="/dashboard" class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold">
                <i class="fa-solid fa-envelope-open-text"></i>
            </div>
            <span class="font-bold text-sm text-white">E-Surat TA</span>
        </a>
        <button id="mobile-sidebar-toggle" class="p-2 text-slate-400 hover:text-white rounded-lg bg-slate-800">
            <i class="fa-solid fa-bars text-lg"></i>
        </button>
    </header>

    <!-- Sidebar Navigation (Desktop & Mobile Drawer) -->
    <aside id="app-sidebar" class="w-64 bg-slate-900 border-r border-slate-800 flex-col justify-between hidden md:flex shrink-0">
        <div>
            <!-- Brand Logo Desktop -->
            <div class="h-16 px-6 hidden md:flex items-center gap-3 border-b border-slate-800">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-bold shadow-lg shadow-indigo-600/40">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
                <div>
                    <h2 class="font-bold text-sm text-white tracking-tight leading-none">E-Surat TA</h2>
                    <span class="text-[10px] font-medium text-slate-400">Teknik Informatika</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1 text-sm font-medium">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                    <i class="fa-solid fa-house w-5 text-center"></i> Halaman Utamas
                </a>

                <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-600/10 text-indigo-400 border border-indigo-500/20 font-semibold">
                    <i class="fa-solid fa-gauge w-5 text-center"></i> Dashboard
                </a>

                <% if (user && user.role === 'mahasiswa') { %>
                    <a href="/mahasiswa/buat-surat" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                        <i class="fa-solid fa-paper-plane w-5 text-center"></i> Pengajuan Surat
                    </a>
                <% } %>

                <% if (user && user.role === 'dosen') { %>
                    <a href="/dosen/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                        <i class="fa-solid fa-inbox w-5 text-center"></i> Inbox Approval
                    </a>
                <% } %>

                <% if (user && user.role === 'sekretaris_prodi') { %>
                    <a href="/sekprodi/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                        <i class="fa-solid fa-user-check w-5 text-center"></i> Validasi & Ploting
                    </a>
                <% } %>

                <% if (user && user.role === 'kaprodi') { %>
                    <a href="/kaprodi/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                        <i class="fa-solid fa-signature w-5 text-center"></i> Otorisasi & E-Signature
                    </a>
                <% } %>

                <% if (user && user.role === 'staff_tu') { %>
                    <a href="/tu/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                        <i class="fa-solid fa-file-pdf w-5 text-center"></i> Penomoran & Output PDF
                    </a>
                <% } %>

                <a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/60 transition">
                    <i class="fa-solid fa-circle-user w-5 text-center"></i> Profil Saya
                </a>
            </nav>
        </div>

        <!-- User Badge & Logout Footer -->
        <div class="p-4 border-t border-slate-800 bg-slate-900/50">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-indigo-400">
                        <%= user ? user.username.substring(0,2).toUpperCase() : 'US' %>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-bold text-slate-200 truncate"><%= user ? user.username : 'User' %></p>
                        <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/10 text-indigo-400 uppercase tracking-wide">
                            <%= user ? user.role.replace('_', ' ') : 'Role' %>
                        </span>
                    </div>
                </div>
                <a href="/logout" title="Logout" class="text-slate-500 hover:text-red-400 transition p-2">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Desktop Header -->
        <header class="h-16 bg-slate-900/60 border-b border-slate-800 px-6 hidden md:flex items-center justify-between backdrop-blur-md">
            <div class="flex items-center gap-4">
                <h1 class="font-bold text-base text-slate-100"><%= title %></h1>
            </div>

            <div class="flex items-center gap-3">
                <span class="text-xs text-slate-400 flex items-center gap-2 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
                    <i class="fa-solid fa-cloud text-emerald-400"></i> Google Drive Cloud Storage: Connected
                </span>
            </div>
        </header>

        <!-- Dynamic Body Page Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6 bg-slate-950">
            <%- body %>
        </main>
    </div>

    <script>
        const btn = document.getElementById('mobile-sidebar-toggle');
        const sidebar = document.getElementById('app-sidebar');
        if (btn && sidebar) {
            btn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('flex');
            });
        }
    </script>
</body>
</html>
