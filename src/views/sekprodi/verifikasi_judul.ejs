<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Validasi Keterbaruan Topik & Ploting Pembimbing (Sekprodi)</h2>
            <p class="text-xs text-slate-500 mt-1">Validasi topik usulan dan tentukan Dosen Pembimbing 1 & 2 sebelum otorisasi Kaprodi.</p>
        </div>
        <a href="/dashboard" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
        </a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 text-xs font-bold">
            <%= success %>
        </div>
    <% } %>

    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-4">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-100 uppercase text-slate-500 font-extrabold border-b border-slate-200">
                    <tr>
                        <th class="p-3">Mahasiswa</th>
                        <th class="p-3">Judul Usulan TA</th>
                        <th class="p-3">Validasi & Ploting Dosen Pembimbing</th>
                        <th class="p-3">Status</th>
                        <th class="p-3">Aksi Sekprodi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-medium">
                    <% proposals.forEach(p => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3">
                                <p class="font-bold text-slate-900"><%= p.mhs_nama %></p>
                                <p class="text-slate-500 font-mono">NIM: <%= p.nim %></p>
                            </td>
                            <td class="p-3 font-semibold text-slate-800 max-w-md space-y-2">
                                <!-- Judul 1 -->
                                <div class="p-2.5 bg-blue-50/80 border border-blue-200 rounded-xl text-xs space-y-1">
                                    <div class="font-extrabold text-blue-900 flex items-center gap-1.5">
                                        <span class="px-1.5 py-0.5 bg-blue-700 text-white rounded text-[10px]">1</span>
                                        <span><%= p.judul_1 || p.judul_ta %></span>
                                    </div>
                                    <% if (p.abstraksi_1 || p.abstrak_rumusan) { %>
                                        <p class="text-[11px] text-slate-600"><strong>Abstraksi:</strong> <%= p.abstraksi_1 || p.abstrak_rumusan %></p>
                                    <% } %>
                                    <% if (p.tujuan_1) { %>
                                        <p class="text-[11px] text-slate-600"><strong>Tujuan:</strong> <%= p.tujuan_1 %></p>
                                    <% } %>
                                    <% if (p.manfaat_1) { %>
                                        <p class="text-[11px] text-slate-600"><strong>Manfaat:</strong> <%= p.manfaat_1 %></p>
                                    <% } %>
                                </div>
                                <!-- Judul 2 -->
                                <% if (p.judul_2) { %>
                                    <div class="p-2.5 bg-emerald-50/80 border border-emerald-200 rounded-xl text-xs space-y-1">
                                        <div class="font-extrabold text-emerald-900 flex items-center gap-1.5">
                                            <span class="px-1.5 py-0.5 bg-emerald-700 text-white rounded text-[10px]">2</span>
                                            <span><%= p.judul_2 %></span>
                                        </div>
                                        <p class="text-[11px] text-slate-600"><strong>Abstraksi:</strong> <%= p.abstraksi_2 %></p>
                                        <p class="text-[11px] text-slate-600"><strong>Tujuan:</strong> <%= p.tujuan_2 %></p>
                                        <p class="text-[11px] text-slate-600"><strong>Manfaat:</strong> <%= p.manfaat_2 %></p>
                                    </div>
                                <% } %>
                                <!-- Judul 3 -->
                                <% if (p.judul_3) { %>
                                    <div class="p-2.5 bg-purple-50/80 border border-purple-200 rounded-xl text-xs space-y-1">
                                        <div class="font-extrabold text-purple-900 flex items-center gap-1.5">
                                            <span class="px-1.5 py-0.5 bg-purple-700 text-white rounded text-[10px]">3</span>
                                            <span><%= p.judul_3 %></span>
                                        </div>
                                        <p class="text-[11px] text-slate-600"><strong>Abstraksi:</strong> <%= p.abstraksi_3 %></p>
                                        <p class="text-[11px] text-slate-600"><strong>Tujuan:</strong> <%= p.tujuan_3 %></p>
                                        <p class="text-[11px] text-slate-600"><strong>Manfaat:</strong> <%= p.manfaat_3 %></p>
                                    </div>
                                <% } %>
                            </td>
                            <td class="p-3">
                                <% if (p.status === 'pending_sekprodi') { %>
                                    <form id="form-sekpro-<%= p.id %>" action="/sekprodi/verifikasi-judul" method="POST" class="space-y-2">
                                        <input type="hidden" name="proposal_id" value="<%= p.id %>">
                                        <div>
                                            <label class="block text-[10px] font-bold text-slate-500 uppercase">Pembimbing 1 *</label>
                                            <select name="dosen_pembimbing_1_id" required class="w-full px-2 py-1 bg-slate-50 border border-slate-300 rounded text-xs">
                                                <% dosenList.forEach(d => { %>
                                                    <option value="<%= d.id %>" <%= p.dosen_pembimbing_1_id === d.id ? 'selected' : '' %>><%= d.nama_dosen %></option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-[10px] font-bold text-slate-500 uppercase">Pembimbing 2 *</label>
                                            <select name="dosen_pembimbing_2_id" required class="w-full px-2 py-1 bg-slate-50 border border-slate-300 rounded text-xs">
                                                <% dosenList.forEach(d => { %>
                                                    <option value="<%= d.id %>" <%= p.dosen_pembimbing_2_id === d.id ? 'selected' : '' %>><%= d.nama_dosen %></option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <input type="text" name="catatan_sekprodi" placeholder="Catatan Topik Sekprodi" class="w-full px-2.5 py-1 bg-slate-50 border border-slate-300 rounded text-xs">
                                    </form>
                                <% } else { %>
                                    <div class="text-[11px] text-slate-700">
                                        <p>P1: <%= p.pembimbing_1_nama %></p>
                                        <p>P2: <%= p.pembimbing_2_nama %></p>
                                    </div>
                                <% } %>
                            </td>
                            <td class="p-3">
                                <% if (p.status === 'pending_sekprodi') { %>
                                    <span class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold">Pending Sekprodi</span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold"><%= p.status.toUpperCase() %></span>
                                <% } %>
                            </td>
                            <td class="p-3">
                                <% if (p.status === 'pending_sekprodi') { %>
                                    <div class="flex items-center gap-2">
                                        <button type="submit" form="form-sekpro-<%= p.id %>" name="status_sekprodi" value="setuju" class="px-3 py-1.5 bg-blue-700 hover:bg-blue-600 text-white font-bold rounded-lg text-[10px]">
                                            <i class="fa-solid fa-check mr-1"></i> Validasi Topik
                                        </button>
                                        <button type="submit" form="form-sekpro-<%= p.id %>" name="status_sekprodi" value="tolak" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-lg text-[10px]">
                                            <i class="fa-solid fa-xmark mr-1"></i> Tolak
                                        </button>
                                    </div>
                                <% } else { %>
                                    <span class="text-slate-400 text-[11px] font-semibold">Telah Divalidasi</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
