<div class="w-full max-w-md bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-8 shadow-2xl space-y-6">
    <div class="text-center">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 mb-3 shadow-lg shadow-indigo-500/20">
            <i class="fa-solid fa-lock-open text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white">Lupa Password</h1>
        <p class="text-xs text-slate-400 mt-1">Masukkan alamat email Anda yang terdaftar untuk menerima tautan reset password.</p>
    </div>

    <% if (error) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs flex items-center gap-3">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <% if (success) { %>
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs flex items-center gap-3">
            <i class="fa-solid fa-circle-check"></i>
            <span><%= success %></span>
        </div>

        <% if (resetUrl) { %>
            <div class="p-4 bg-slate-950 rounded-2xl border border-slate-800 text-left space-y-2">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Simulasi Reset Link Instant:</span>
                <a href="<%= resetUrl %>" class="block text-center py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs shadow transition">
                    <i class="fa-solid fa-key mr-1"></i> Buka Halaman Reset Password
                </a>
            </div>
        <% } %>
    <% } else { %>
        <form action="/forgot-password" method="POST" class="space-y-4 text-xs">
            <div>
                <label for="email" class="block font-semibold text-slate-300 uppercase mb-2">Alamat Email Terdaftar *</label>
                <input type="email" id="email" name="email" required placeholder="nama@univ.ac.id"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-indigo-500 text-sm text-slate-100 placeholder-slate-500">
            </div>

            <button type="submit" class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs shadow-lg shadow-indigo-600/30 transition transform hover:-translate-y-0.5">
                <i class="fa-solid fa-paper-plane mr-2"></i> Kirim Tautan Reset Password
            </button>
        </form>
    <% } %>

    <div class="pt-4 border-t border-slate-800 text-center text-xs text-slate-400">
        Kembai ke <a href="/login" class="text-indigo-400 font-bold hover:underline">Halaman Login</a>
    </div>
</div>
