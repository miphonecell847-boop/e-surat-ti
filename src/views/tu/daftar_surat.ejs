<div class="max-w-6xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Daftar Permohonan Surat & ACC Penomoran (Staff TU)</h2>
            <p class="text-xs text-slate-500 mt-1">Kelola permohonan surat mahasiswa, berikan ACC nomor surat resmi, dan terbitkan PDF berkode QR.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button onclick="openModalUploadKaprodi()" class="px-3.5 py-2.5 bg-purple-700 hover:bg-purple-600 text-white text-xs font-extrabold rounded-xl transition shadow-lg flex items-center gap-2">
                <i class="fa-solid fa-file-signature text-amber-400"></i> <%= (typeof hasTtdKaprodi !== 'undefined' && hasTtdKaprodi) ? 'Perbaharui TTD Digital Kaprodi' : 'Unggah TTD Digital Kaprodi' %>
            </button>
            <button onclick="openModalUploadDekan()" class="px-3.5 py-2.5 bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-extrabold rounded-xl transition shadow-lg flex items-center gap-2">
                <i class="fa-solid fa-file-signature text-amber-400"></i> <%= (typeof hasTtdDekan !== 'undefined' && hasTtdDekan) ? 'Perbaharui TTD Digital Dekan' : 'Unggah TTD Digital Dekan' %>
            </button>
            <a href="/dashboard" class="px-3.5 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
                <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
            </a>
        </div>
    </div>

    <!-- Category & Status Filters -->
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
        <form action="/tu/daftar-surat" method="GET" class="flex flex-col sm:flex-row items-center gap-4">
            <div class="flex-1 w-full">
                <label class="block text-[10px] font-extrabold text-slate-500 uppercase tracking-wider mb-1">Filter Kategori Jenis Surat:</label>
                <select name="jenis_surat_id" onchange="this.form.submit()" class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-slate-800">
                    <option value="">-- Semua Kategori Jenis Surat --</option>
                    <% jenisList.forEach(j => { %>
                        <option value="<%= j.id %>" <%= selectedJenis == j.id ? 'selected' : '' %>><%= j.nama_surat %> (<%= j.kode_surat %>)</option>
                    <% }); %>
                </select>
            </div>
            <% if (selectedJenis) { %>
                <a href="/tu/daftar-surat" class="self-end px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold rounded-xl">Reset Filter</a>
            <% } %>
        </form>
    </div>

    <!-- Letter Table -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-4">
        <div class="overflow-x-auto">
            <table data-paginate class="w-full text-left text-xs">
                <thead class="bg-slate-100 uppercase text-slate-500 font-extrabold border-b border-slate-200">
                    <tr>
                        <th class="p-3">Mahasiswa Pemohon</th>
                        <th class="p-3">Jenis Surat & Kode</th>
                        <th class="p-3">Perihal / Topik</th>
                        <th class="p-3">Nomor Surat Resmi</th>
                        <th class="p-3">Status Disposisi</th>
                        <th class="p-3 text-right">Aksi Penomoran & PDF</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-medium">
                    <% if (suratList && suratList.length > 0) { %>
                        <% suratList.forEach(s => { %>
                            <% if (s.kode_surat === 'KARTU-BIMBINGAN' || s.kode_surat === 'LMBR-PERSETUJUAN-WKT' || s.kode_surat === 'BA-UJIAN' || s.template_path === 'kartu_bimbingan' || s.template_path === 'lembar_persetujuan_waktu' || s.template_path === 'berita_acara_ujian') return; %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-3">
                                    <p class="font-extrabold text-slate-900"><%= s.mhs_nama %></p>
                                    <p class="text-blue-600 font-mono text-[10px] font-bold">NIM: <%= s.mhs_nim %></p>
                                </td>
                                <td class="p-3 font-semibold text-slate-900">
                                    <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 font-mono text-[10px] font-bold"><%= s.kode_surat %></span>
                                    <p class="mt-0.5 text-[11px] font-bold text-slate-800"><%= s.nama_surat %></p>
                                </td>
                                <td class="p-3 text-slate-700 max-w-xs"><%= s.perihal %></td>
                                <td class="p-3">
                                    <% if (s.nomor_surat) { %>
                                        <span class="font-mono text-xs font-bold text-slate-900 bg-slate-100 px-2 py-1 rounded-md border border-slate-300 block w-fit"><%= s.nomor_surat %></span>
                                    <% } else { %>
                                        <span class="text-slate-400 italic text-[11px]">Belum Ada Nomor</span>
                                    <% } %>
                                </td>
                                <td class="p-3">
                                    <div class="space-y-1">
                                        <% if (s.status === 'pending_tu') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-300 text-[10px] font-extrabold block w-fit">
                                                <i class="fa-solid fa-clock mr-1"></i> Perlu ACC & Nomor
                                            </span>
                                        <% } else if (s.status === 'selesai') { %>
                                            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] font-extrabold block w-fit">
                                                <i class="fa-solid fa-check-circle mr-1"></i> SELESAI (PDF Ready)
                                            </span>
                                        <% } else { %>
                                            <span class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold block w-fit"><%= s.status.toUpperCase() %></span>
                                        <% } %>

                                        <% if (s.kode_surat && (s.kode_surat.startsWith('UND-') || s.kode_surat.includes('UNDANGAN') || s.kode_surat === 'LMBR-PERSETUJUAN-WKT')) { %>
                                            <% const cnt = typeof s.respondedCount !== 'undefined' ? s.respondedCount : 0; %>
                                            <% if (cnt >= 5) { %>
                                                <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-300 text-[10px] font-extrabold flex items-center gap-1 w-fit">
                                                    <i class="fa-solid fa-users-check text-emerald-600"></i> Respon Dosen: 5/5 (Lengkap)
                                                </span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-300 text-[10px] font-bold flex items-center gap-1 w-fit">
                                                    <i class="fa-solid fa-user-clock text-amber-600"></i> Respon Dosen: <%= cnt %>/5
                                                </span>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="p-3 text-right">
                                    <div class="flex items-center justify-end gap-1.5 flex-wrap">
                                        
                                        <!-- Tombol ACC & Input Nomor Surat -->
                                        <% if (s.status === 'pending_tu' || !s.nomor_surat) { %>
                                            <button type="button"
                                                data-id="<%= s.id %>"
                                                data-nama="<%= s.mhs_nama %>"
                                                data-nim="<%= s.mhs_nim %>"
                                                data-jenis="<%= s.nama_surat %>"
                                                data-nomor="<%= s.nomor_surat || '' %>"
                                                onclick="handleOpenAccNomorModal(this)"
                                                class="px-3 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold rounded-xl text-[11px] shadow-md shadow-emerald-600/20 flex items-center gap-1 transition transform hover:-translate-y-0.5">
                                                <i class="fa-solid fa-file-signature text-amber-300"></i> ACC & Input Nomor
                                            </button>
                                        <% } %>

                                        <button type="button"
                                            onclick="openWaModalForSurat('<%= s.id %>', '<%= s.mhs_nama %>', '<%= s.mhs_nim %>', '<%= s.nama_surat %>', '<%= s.nomor_surat || '' %>')"
                                            title="Kirim Notifikasi WhatsApp Fonnte"
                                            class="px-2.5 py-1.5 bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 text-emerald-700 font-extrabold rounded-xl text-[10px] flex items-center gap-1">
                                            <i class="fa-brands fa-whatsapp text-emerald-600 text-xs"></i> WA
                                        </button>

                                        <a href="/surat/detail/<%= s.id %>" class="px-2.5 py-1.5 bg-blue-50 border border-blue-200 hover:bg-blue-100 text-blue-700 font-bold rounded-xl text-[10px] flex items-center gap-1">
                                            <i class="fa-solid fa-clock-rotate-left text-blue-600"></i> Detail Status
                                        </a>

                                        <button type="button"
                                            data-id="<%= s.id %>"
                                            data-title="<%= s.nama_surat %>"
                                            onclick="handleOpenPdfPreview(this)"
                                            class="px-2.5 py-1.5 bg-slate-100 border border-slate-300 hover:bg-slate-200 text-slate-800 font-bold rounded-xl text-[10px] flex items-center gap-1">
                                            <i class="fa-solid fa-file-pdf text-rose-600"></i> Preview PDF
                                        </button>

                                        <a href="/tu/edit-surat/<%= s.id %>" title="Edit Data Surat" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-[10px]">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form action="/tu/delete-surat/<%= s.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus permohonan surat ini?');" class="inline">
                                            <button type="submit" title="Hapus Surat" class="px-2 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold rounded-xl text-[10px]">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="p-8 text-center text-slate-500 text-xs">Tidak ada surat ditemukan untuk kategori filter ini.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal ACC & Input Nomor Surat Interaktif -->
<div id="acc-nomor-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-lg rounded-3xl overflow-hidden shadow-2xl space-y-5 p-6 border border-slate-200">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                    <i class="fa-solid fa-file-signature text-sm"></i>
                </div>
                <h3 class="font-extrabold text-sm text-slate-900">ACC & Penomoran Surat Resmi</h3>
            </div>
            <button onclick="closeAccNomorModal()" class="text-slate-400 hover:text-slate-600 font-bold text-xs p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form id="acc-nomor-form" action="" method="POST" class="space-y-4">
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 space-y-2 text-xs">
                <p class="text-slate-500 font-medium">Mahasiswa Pemohon: <span id="modal-mhs-nama" class="font-bold text-slate-900"></span> (<span id="modal-mhs-nim" class="font-mono text-blue-600"></span>)</p>
                <p class="text-slate-500 font-medium">Jenis Surat: <span id="modal-jenis-surat" class="font-extrabold text-blue-950"></span></p>
            </div>

            <div>
                <label for="modal_nomor_surat" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1.5">Nomor Surat Resmi *</label>
                <input type="text" id="modal_nomor_surat" name="nomor_surat" required placeholder="Contoh: B/345/UN.1/TI/TA/2026"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-emerald-600 font-mono text-xs font-bold text-slate-900 transition">
                <p class="text-[10px] text-slate-400 mt-1 italic">Sistem menyarankan format nomor standar di atas. Anda dapat menyesuaikannya.</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="closeAccNomorModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">
                    Batal
                </button>
                <button type="submit" class="px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white rounded-xl text-xs font-extrabold shadow-lg shadow-emerald-600/30 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-check-circle text-amber-300"></i> ACC & Terbitkan PDF Resmi
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal PDF Preview Interaktif -->
<div id="pdf-preview-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-4xl h-[90vh] rounded-3xl overflow-hidden shadow-2xl flex flex-col">
        <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-file-pdf text-amber-400 text-lg"></i>
                <h3 id="pdf-modal-title" class="font-extrabold text-sm">Preview Dokumen Surat PDF</h3>
            </div>
            <button onclick="closePdfPreview()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-xs font-bold transition">
                <i class="fa-solid fa-xmark mr-1"></i> Tutup Preview
            </button>
        </div>
        <div class="flex-1 bg-slate-100 relative">
            <iframe id="pdf-preview-iframe" class="w-full h-full border-0" src=""></iframe>
        </div>
    </div>
</div>

<script>
    function handleOpenAccNomorModal(btn) {
        const id = btn.getAttribute('data-id');
        const namaMhs = btn.getAttribute('data-nama');
        const nimMhs = btn.getAttribute('data-nim');
        const jenisSurat = btn.getAttribute('data-jenis');
        const existingNomor = btn.getAttribute('data-nomor');

        document.getElementById('modal-mhs-nama').innerText = namaMhs;
        document.getElementById('modal-mhs-nim').innerText = nimMhs;
        document.getElementById('modal-jenis-surat').innerText = jenisSurat;
        
        const randomNum = Math.floor(100 + Math.random() * 900);
        document.getElementById('modal_nomor_surat').value = existingNomor || ('B/' + randomNum + '/UN.1/TI/TA/2026');
        
        document.getElementById('acc-nomor-form').action = '/tu/penomoran/' + id;
        document.getElementById('acc-nomor-modal').classList.remove('hidden');
    }

    function closeAccNomorModal() {
        document.getElementById('acc-nomor-modal').classList.add('hidden');
    }

    function handleOpenPdfPreview(btn) {
        const suratId = btn.getAttribute('data-id');
        const title = btn.getAttribute('data-title');

        document.getElementById('pdf-modal-title').innerText = 'Preview Dokumen: ' + title;
        document.getElementById('pdf-preview-iframe').src = '/surat/preview/' + suratId;
        document.getElementById('pdf-preview-modal').classList.remove('hidden');
    }
    
    function closePdfPreview() {
        document.getElementById('pdf-preview-modal').classList.add('hidden');
        document.getElementById('pdf-preview-iframe').src = '';
    }

    function openModalUploadKaprodi() {
        document.getElementById('modal-upload-kaprodi').classList.remove('hidden');
    }
    function closeModalUploadKaprodi() {
        document.getElementById('modal-upload-kaprodi').classList.add('hidden');
    }

    function openModalUploadDekan() {
        document.getElementById('modal-upload-dekan').classList.remove('hidden');
    }
    function closeModalUploadDekan() {
        document.getElementById('modal-upload-dekan').classList.add('hidden');
    }
</script>

<!-- Modal Upload TTD Digital Kaprodi -->
<div id="modal-upload-kaprodi" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-5 border border-slate-200">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-file-signature text-purple-600"></i> <%= (typeof hasTtdKaprodi !== 'undefined' && hasTtdKaprodi) ? 'Perbaharui TTD Digital Kaprodi' : 'Unggah TTD Digital Kaprodi' %>
            </h3>
            <button onclick="closeModalUploadKaprodi()" class="text-slate-400 hover:text-slate-600 p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form action="/tu/upload-ttd-kaprodi" method="POST" enctype="multipart/form-data" class="space-y-4">
            <p class="text-xs text-slate-600">Unggah berkas spesimen tanda tangan digital Plt. Kaprodi (Prof. Dr. Rasmuin, S.Pd., M.Pd.) format PNG/JPG transparan.</p>

            <div class="space-y-1.5">
                <label class="block text-[11px] font-extrabold text-slate-700 uppercase">File Spesimen TTD Kaprodi:</label>
                <input type="file" name="ttd_kaprodi" accept="image/png, image/jpeg" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-medium text-slate-700 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-purple-100 file:text-purple-800 hover:file:bg-purple-200">
            </div>

            <div class="pt-3 flex items-center justify-end gap-2 border-t border-slate-100">
                <button type="button" onclick="closeModalUploadKaprodi()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl">Batal</button>
                <button type="submit" class="px-5 py-2 bg-purple-700 hover:bg-purple-600 text-white text-xs font-extrabold rounded-xl shadow-md">Simpan Spesimen TTD Kaprodi</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Upload TTD Digital Dekan -->
<div id="modal-upload-dekan" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-5 border border-slate-200">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-file-signature text-emerald-600"></i> <%= (typeof hasTtdDekan !== 'undefined' && hasTtdDekan) ? 'Perbaharui TTD Digital Dekan' : 'Unggah TTD Digital Dekan' %>
            </h3>
            <button onclick="closeModalUploadDekan()" class="text-slate-400 hover:text-slate-600 p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <form action="/tu/upload-ttd-dekan" method="POST" enctype="multipart/form-data" class="space-y-4">
            <p class="text-xs text-slate-600">Unggah berkas spesimen tanda tangan digital Dekan (Ir. HILDA SULAIMAN NUR, S.T., M.T.) format PNG/JPG transparan.</p>

            <div class="space-y-1.5">
                <label class="block text-[11px] font-extrabold text-slate-700 uppercase">File Spesimen TTD Dekan:</label>
                <input type="file" name="ttd_dekan" accept="image/png, image/jpeg" required class="w-full px-3 py-2 bg-slate-50 border border-slate-300 rounded-xl text-xs font-medium text-slate-700 file:mr-3 file:py-1 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200">
            </div>

            <div class="pt-3 flex items-center justify-end gap-2 border-t border-slate-100">
                <button type="button" onclick="closeModalUploadDekan()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl">Batal</button>
                <button type="submit" class="px-5 py-2 bg-emerald-700 hover:bg-emerald-600 text-white text-xs font-extrabold rounded-xl shadow-md">Simpan Spesimen TTD Dekan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Kirim Notifikasi WA Interaktif (Daftar Surat Admin) -->
<div id="wa-modal-daftar" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 w-full max-w-lg rounded-3xl p-6 shadow-2xl space-y-5 text-white">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                    <i class="fa-brands fa-whatsapp text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-sm text-white">Kirim Notifikasi WhatsApp Fonnte</h3>
                    <p class="text-[11px] text-slate-400">Pilih tujuan pengiriman pesan notifikasi</p>
                </div>
            </div>
            <button type="button" onclick="closeWaModalDaftar()" class="text-slate-400 hover:text-white p-1">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>
        </div>

        <form id="wa-form-daftar" action="" method="POST" class="space-y-4 text-xs">
            <input type="hidden" name="redirect_url" value="/tu/daftar-surat">
            
            <div class="p-3.5 bg-slate-950/60 border border-slate-800 rounded-2xl space-y-1">
                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Mahasiswa & Dokumen Target</p>
                <p id="wa-mhs-info" class="font-bold text-slate-200 text-sm">-</p>
                <p id="wa-surat-info" class="text-slate-300">-</p>
            </div>

            <div class="space-y-3">
                <label class="block font-bold text-slate-300">Pilih Target Tujuan Pengiriman *</label>
                
                <div class="p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl flex items-start gap-3 cursor-pointer hover:border-emerald-500/50 transition" onclick="document.getElementById('mode_dosen_daftar').checked=true; toggleCustomPhoneInputDaftar();">
                    <input type="radio" id="mode_dosen_daftar" name="target_mode" value="dosen" checked onchange="toggleCustomPhoneInputDaftar()" class="mt-0.5 text-emerald-500 focus:ring-emerald-500">
                    <div>
                        <label for="mode_dosen_daftar" class="font-bold text-slate-200 cursor-pointer block">Kirim ke Seluruh Dosen Pembimbing & Penguji</label>
                        <p class="text-[11px] text-slate-400 mt-0.5">Pesan dikirimkan otomatis ke WhatsApp Pembimbing 1, Pembimbing 2, Penguji 1, 2, dan 3.</p>
                    </div>
                </div>

                <div class="p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl flex items-start gap-3 cursor-pointer hover:border-emerald-500/50 transition" onclick="document.getElementById('mode_custom_daftar').checked=true; toggleCustomPhoneInputDaftar();">
                    <input type="radio" id="mode_custom_daftar" name="target_mode" value="custom" onchange="toggleCustomPhoneInputDaftar()" class="mt-0.5 text-emerald-500 focus:ring-emerald-500">
                    <div class="w-full">
                        <label for="mode_custom_daftar" class="font-bold text-slate-200 cursor-pointer block">Kirim ke Nomor WA Tes Custom (HP Anda)</label>
                        <p class="text-[11px] text-slate-400 mt-0.5">Masukkan nomor WA pribadi Anda sendiri untuk menguji pengiriman langsung di HP Anda.</p>
                        
                        <div id="custom-phone-container-daftar" class="hidden mt-2.5">
                            <input type="text" id="custom_phone_daftar" name="custom_phone" placeholder="Contoh: 082212345678" class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-emerald-400 font-bold focus:outline-none focus:border-emerald-500">
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-slate-800">
                <button type="button" onclick="closeWaModalDaftar()" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl">
                    Batal
                </button>
                <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold rounded-xl shadow-lg shadow-emerald-600/30 flex items-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i> Kirim WA Sekarang
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openWaModalForSurat(id, mhsNama, mhsNim, namaSurat, nomorSurat) {
        document.getElementById('wa-form-daftar').action = '/tu/kirim-wa-manual/' + id;
        document.getElementById('wa-mhs-info').innerText = mhsNama + ' (NIM: ' + mhsNim + ')';
        document.getElementById('wa-surat-info').innerText = namaSurat + (nomorSurat ? ' — ' + nomorSurat : '');
        document.getElementById('wa-modal-daftar').classList.remove('hidden');
    }
    function closeWaModalDaftar() {
        document.getElementById('wa-modal-daftar').classList.add('hidden');
    }
    function toggleCustomPhoneInputDaftar() {
        const isCustom = document.getElementById('mode_custom_daftar').checked;
        const container = document.getElementById('custom-phone-container-daftar');
        if (isCustom) {
            container.classList.remove('hidden');
            document.getElementById('custom_phone_daftar').focus();
        } else {
            container.classList.add('hidden');
        }
    }
</script>
