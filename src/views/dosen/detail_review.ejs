<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-white">Review Pengajuan Surat Mahasiswa</h2>
            <p class="text-xs text-slate-400 mt-1">Status Disposisi Saat Ini: <span class="font-bold text-amber-400 uppercase"><%= pengajuan.status.replace(/_/g, ' ') %></span></p>
        </div>
        <a href="/dosen/dashboard" class="px-4 py-2 bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-300 text-xs font-semibold rounded-xl transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Inbox
        </a>
    </div>

    <!-- Mahasiswa & Surat Information -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Identitas Mahasiswa</span>
            <h3 class="text-base font-bold text-white"><%= pengajuan.mhs_nama %></h3>
            <p class="text-xs text-indigo-400 font-mono">NIM: <%= pengajuan.mhs_nim %> | Angkatan <%= pengajuan.mhs_angkatan %></p>
            <p class="text-xs text-slate-400 mt-2">Judul TA: "<%= pengajuan.mhs_judul_ta || '-' %>"</p>
        </div>

        <div class="space-y-3 border-t md:border-t-0 md:border-l border-slate-800 pt-4 md:pt-0 md:pl-6">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Jenis Surat</span>
                <p class="text-sm font-bold text-white"><%= pengajuan.nama_surat %></p>
                <p class="text-xs text-indigo-400 font-mono"><%= pengajuan.kode_surat %></p>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Perihal</span>
                <p class="text-xs text-slate-200"><%= pengajuan.perihal %></p>
            </div>
        </div>
    </div>

    <!-- Google Drive Attachments Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl">
        <h3 class="font-bold text-sm text-white mb-4 border-b border-slate-800 pb-3">Berkas Dokumen Pendukung (Google Drive)</h3>
        <% if (docs && docs.length > 0) { %>
            <div class="space-y-3">
                <% docs.forEach(doc => { %>
                    <div class="p-4 bg-slate-950/60 rounded-2xl border border-slate-800 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-file-pdf text-red-400 text-2xl"></i>
                            <div>
                                <h4 class="text-xs font-bold text-white"><%= doc.nama_file_original %></h4>
                                <p class="text-[10px] text-slate-400 uppercase">Kategori: <%= doc.kategori_berkas.replace(/_/g, ' ') %></p>
                            </div>
                        </div>
                        <a href="<%= doc.web_view_link %>" target="_blank" class="px-4 py-2 bg-indigo-600/10 border border-indigo-500/20 text-indigo-400 hover:bg-indigo-600/20 rounded-xl text-xs font-semibold transition">
                            <i class="fa-brands fa-google-drive mr-1"></i> Buka File
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p class="text-xs text-slate-500">Tidak ada lampiran berkas yang diunggah.</p>
        <% } %>
    </div>

    <!-- Action Review Form -->
    <form action="/dosen/review/<%= pengajuan.id %>" method="POST" class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-4">
        <h3 class="font-bold text-sm text-white border-b border-slate-800 pb-3">Keputusan Approval Dosen Pembimbing</h3>
        
        <div>
            <label for="catatan_revisi" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Catatan Review / Catatan Revisi (Opsional)</label>
            <textarea id="catatan_revisi" name="catatan_revisi" rows="3" placeholder="Masukkan catatan atau instruksi perbaikan jika ada..."
                class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-indigo-500 text-sm text-slate-100 placeholder-slate-500 transition"></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
            <button type="submit" name="action" value="approve" class="w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-check-double"></i> Setujui & Lanjutkan Disposisi (Acc)
            </button>
            <button type="submit" name="action" value="revision" class="w-full sm:w-auto px-6 py-3 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-amber-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-pen-to-square"></i> Minta Revisi
            </button>
            <button type="submit" name="action" value="reject" class="w-full sm:w-auto px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-red-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-xmark"></i> Tolak Pengajuan
            </button>
        </div>
    </form>
</div>
