<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-950 font-sans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'E-Surat Administrasi TA UNIDAYAN' %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6.5.1 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="h-full flex flex-col md:flex-row overflow-hidden bg-slate-950 text-slate-100">

    <!-- Mobile Header -->
    <div class="md:hidden bg-slate-900 border-b border-slate-800 p-4 flex items-center justify-between z-20">
        <div class="flex items-center gap-3">
            <img src="/images/logo-unidayan.png" alt="Logo UNIDAYAN" class="w-8 h-8 object-contain">
            <span class="font-bold text-sm tracking-tight text-white">E-Surat UNIDAYAN</span>
        </div>
        <button id="mobile-sidebar-toggle" class="p-2 rounded-lg bg-slate-800 text-slate-300 hover:text-white">
            <i class="fa-solid fa-bars text-lg"></i>
        </button>
    </div>

    <!-- Sidebar Navigation -->
    <aside id="app-sidebar" class="w-full md:w-72 bg-slate-900 border-r border-slate-800 flex-col justify-between hidden md:flex z-10 shrink-0">
        <div>
            <!-- Brand & Academic Crest -->
            <div class="p-6 border-b border-slate-800/80 flex items-center gap-3.5">
                <img src="/images/logo-unidayan.png" alt="Logo UNIDAYAN" class="w-10 h-10 object-contain drop-shadow-md">
                <div>
                    <h2 class="font-extrabold text-sm tracking-tight text-white leading-tight">E-Surat TA</h2>
                    <span class="text-[10px] font-semibold text-slate-400">Teknik Informatika</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="p-4 space-y-1 text-sm font-medium">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                    <i class="fa-solid fa-house w-5 text-center text-amber-400"></i> Halaman Utama
                </a>

                <% if (user && user.role === 'mahasiswa') { %>
                    <a href="/mahasiswa/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-gauge w-5 text-center text-amber-400"></i> Dashboard Mahasiswa
                    </a>
                    <a href="/mahasiswa/pengajuan-judul" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-book-bookmark w-5 text-center text-amber-400"></i> Pengajuan Judul TA
                    </a>
                    <a href="/mahasiswa/buat-surat" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-paper-plane w-5 text-center text-blue-400"></i> Pengajuan Surat
                    </a>
                    <a href="/mahasiswa/jadwal-ujian" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-calendar-days w-5 text-center text-amber-400"></i> Jadwal Ujian & Seminar
                    </a>
                <% } %>

                <% if (user && user.role === 'dosen') { %>
                    <a href="/dosen/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-inbox w-5 text-center text-emerald-400"></i> Inbox Approval & SK
                    </a>
                    <a href="/dosen/konfirmasi-bimbingan" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-bell w-5 text-center text-amber-400"></i> Konfirmasi Bimbingan
                    </a>
                    <a href="/mahasiswa/jadwal-ujian" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-calendar-days w-5 text-center text-purple-400"></i> Jadwal Ujian Mahasiswa
                    </a>
                <% } %>

                <% if (user && (user.role === 'staff_tu' || user.role === 'stafftu' || user.role === 'admin' || user.role === 'sekretaris_prodi' || user.role === 'kaprodi')) { %>
                    <a href="/tu/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-file-pdf w-5 text-center text-emerald-400"></i> Dashboard Staff TU
                    </a>
                    <a href="/tu/daftar-surat" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-list-check w-5 text-center text-cyan-400"></i> Daftar Permohonan Surat
                    </a>
                    <a href="/tu/buat-surat" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-file-circle-plus w-5 text-center text-blue-400"></i> Buat Surat Permintaan
                    </a>
                    <a href="/tu/verifikasi-judul" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-file-check w-5 text-center text-purple-400"></i> Verifikasi Judul TA
                    </a>
                    <a href="/tu/kelola-akun" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition">
                        <i class="fa-solid fa-user-gear w-5 text-center text-amber-400"></i> Kelola & Validasi Akun
                    </a>
                <% } %>

                <a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/80 transition">
                    <i class="fa-solid fa-circle-user w-5 text-center"></i> Profil Saya
                </a>

                <a href="/change-password" class="flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/80 transition">
                    <i class="fa-solid fa-key w-5 text-center"></i> Ganti Password
                </a>

                <a href="https://www.unidayan.ac.id" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-4 py-3 rounded-xl text-amber-400 hover:text-amber-300 hover:bg-slate-800/80 transition">
                    <i class="fa-solid fa-globe w-5 text-center"></i> Web UNIDAYAN
                </a>
            </nav>
        </div>

        <!-- User Badge & Logout Footer -->
        <div class="p-4 border-t border-slate-800 bg-slate-950/60">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 overflow-hidden">
                    <div class="w-9 h-9 rounded-full bg-blue-900 border border-amber-400/30 flex items-center justify-center text-xs font-bold text-amber-400 shrink-0">
                        <%= user ? user.username.substring(0,2).toUpperCase() : 'US' %>
                    </div>
                    <div class="truncate">
                        <p class="text-xs font-bold text-slate-200 truncate"><%= user ? user.username : 'Guest' %></p>
                        <p class="text-[10px] text-amber-400 font-semibold uppercase tracking-wider"><%= user ? user.role : 'Guest' %></p>
                    </div>
                </div>
                <a href="/logout" title="Logout" class="text-slate-400 hover:text-rose-400 transition p-2">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Desktop Academic Header -->
        <header class="h-20 bg-slate-900 border-b border-slate-800 px-6 hidden md:flex items-center justify-between text-white">
            <div class="flex items-center gap-3">
                <h1 class="font-extrabold text-base tracking-tight text-white"><%= title %></h1>
            </div>

            <div class="flex items-center gap-3">
                <a href="https://www.unidayan.ac.id" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-amber-400 hover:underline flex items-center gap-1.5 bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800">
                    <i class="fa-solid fa-globe"></i> www.unidayan.ac.id
                </a>
                <span class="text-xs text-slate-300 flex items-center gap-2 bg-slate-950 px-3.5 py-2 rounded-xl border border-slate-800 shadow-inner">
                    <i class="fa-brands fa-google-drive text-emerald-400"></i> Google Drive Cloud: Connected
                </span>
            </div>
        </header>

        <!-- Dynamic Body Page Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6 bg-slate-100 text-slate-800">
            <%- body %>
        </main>
    </div>

    <script>
        const btn = document.getElementById('mobile-sidebar-toggle');
        const sidebar = document.getElementById('app-sidebar');
        if (btn && sidebar) {
            btn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('flex');
            });
        }

        // Precise Single-Active Menu Highlighter based on exact URL matching
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('nav a');
            
            let bestMatchLink = null;
            let maxMatchLen = -1;

            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (!href || href === '#' || href.startsWith('http')) return;

                let isMatch = false;
                if (href === '/') {
                    isMatch = (currentPath === '/');
                } else {
                    isMatch = (currentPath === href || currentPath.startsWith(href + '/'));
                }

                if (isMatch && href.length > maxMatchLen) {
                    maxMatchLen = href.length;
                    bestMatchLink = link;
                }
            });

            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (!href || href.startsWith('http')) return;

                if (link === bestMatchLink) {
                    link.className = "flex items-center gap-3 px-4 py-3 rounded-xl bg-blue-600/20 text-blue-300 border border-blue-500/30 font-semibold shadow-sm";
                } else {
                    link.className = "flex items-center gap-3 px-4 py-3 rounded-xl text-slate-300 hover:text-slate-100 hover:bg-slate-800/80 transition";
                }
            });
        });
    </script>
</body>
</html>
