<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Form Edit Surat Administrasi (Staff TU)</h2>
            <p class="text-xs text-slate-500 mt-1">Perbarui data perihal, instansi tujuan, mahasiswa pemohon, atau spesimen TTD Digital Staff TU.</p>
        </div>
        <a href="/tu/daftar-surat" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Daftar Surat
        </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 text-xs font-bold flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-base"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <form action="/tu/edit-surat/<%= pengajuan.id %>" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-6 shadow-xl">
        <h3 class="text-sm font-black text-slate-900 border-b border-slate-200 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-pen-to-square text-amber-500"></i> Edit Data Surat Pengajuan (#<%= pengajuan.id %>)
        </h3>

        <!-- Pilih Mahasiswa -->
        <div>
            <label for="mahasiswa_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Mahasiswa Pemohon *</label>
            <select id="mahasiswa_id" name="mahasiswa_id" required class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                <% mahasiswaList.forEach(m => { %>
                    <option value="<%= m.id %>" <%= pengajuan.mahasiswa_id == m.id ? 'selected' : '' %>>
                        <%= m.nama_lengkap %> (NIM: <%= m.nim %> - Angkatan <%= m.angkatan %>)
                    </option>
                <% }); %>
            </select>
        </div>

        <!-- Pilih Jenis Surat (10 Jenis Surat) -->
        <div>
            <label for="jenis_surat_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Kategori Jenis Surat *</label>
            <select id="jenis_surat_id" name="jenis_surat_id" required onchange="toggleFormFields(this)" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                <% jenisList.forEach(j => { %>
                    <option value="<%= j.id %>" data-kode="<%= j.kode_surat %>" <%= pengajuan.jenis_surat_id == j.id ? 'selected' : '' %>>
                        <%= j.nama_surat %> (<%= j.kode_surat %>)
                    </option>
                <% }); %>
            </select>
        </div>

        <!-- Tim Dosen Pembimbing -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 bg-blue-50/50 border border-blue-200/60 rounded-2xl">
            <div>
                <label for="pembimbing_1_id" class="block text-xs font-extrabold text-blue-900 uppercase tracking-wider mb-2">Dosen Pembimbing 1 (Utama) *</label>
                <select id="pembimbing_1_id" name="pembimbing_1_id" required class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                    <option value="" disabled>-- Pilih Pembimbing 1 --</option>
                    <% if (typeof dosenList !== 'undefined' && dosenList) { %>
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (dinamisObj && dinamisObj.pembimbing_1_id == d.id) ? 'selected' : '' %>>
                                <%= d.nama_dosen %> (<%= d.nip_nidn %>)
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div>
                <label for="pembimbing_2_id" class="block text-xs font-extrabold text-blue-900 uppercase tracking-wider mb-2">Dosen Pembimbing 2 (Pendamping) *</label>
                <select id="pembimbing_2_id" name="pembimbing_2_id" required class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                    <option value="" disabled>-- Pilih Pembimbing 2 --</option>
                    <% if (typeof dosenList !== 'undefined' && dosenList) { %>
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (dinamisObj && dinamisObj.pembimbing_2_id == d.id) ? 'selected' : '' %>>
                                <%= d.nama_dosen %> (<%= d.nip_nidn %>)
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
        </div>

        <!-- Perihal Surat -->
        <div>
            <label for="perihal" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Perihal Surat *</label>
            <input type="text" id="perihal" name="perihal" required value="<%= pengajuan.perihal %>" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
        </div>

        <!-- Dynamic Fields Container (Adjusts Form Fields Based on Letter Type) -->
        <div id="dynamic-fields-container" class="space-y-5 p-5 bg-slate-50 border border-slate-200 rounded-2xl">
            <h4 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2 flex items-center gap-2 border-b border-slate-200 pb-2">
                <i class="fa-solid fa-list-check text-blue-600"></i> Detail Isian Spesifik Jenis Surat
            </h4>

            <!-- 1. Fields for SRT-IZIN-PENELITIAN -->
            <div id="field-srt-izin-penelitian" class="space-y-4 dynamic-section hidden">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Nama Instansi / Perusahaan Tujuan *</label>
                        <input type="text" name="tujuan_instansi" value="<%= (dinamisObj && (dinamisObj.tujuan_instansi || dinamisObj.instansi_tujuan)) ? (dinamisObj.tujuan_instansi || dinamisObj.instansi_tujuan) : '' %>" placeholder="Contoh: Kepala Dinas Komunikasi dan Informatika"
                            class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Durasi / Waktu Penelitian</label>
                        <input type="text" name="durasi" value="<%= (dinamisObj && dinamisObj.durasi) ? dinamisObj.durasi : '' %>" placeholder="Contoh: 2 Bulan"
                            class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Alamat / Lokasi Instansi *</label>
                    <input type="text" name="alamat_instansi" value="<%= (dinamisObj && dinamisObj.alamat_instansi) ? dinamisObj.alamat_instansi : '' %>" placeholder="Contoh: Jl. Sultan Dayanu Ikhsanuddin No. 124"
                        class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Mulai Penelitian</label>
                        <input type="date" name="tgl_mulai_penelitian" value="<%= (dinamisObj && dinamisObj.tgl_mulai_penelitian) ? dinamisObj.tgl_mulai_penelitian : '' %>" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Selesai Penelitian</label>
                        <input type="date" name="tgl_selesai_penelitian" value="<%= (dinamisObj && dinamisObj.tgl_selesai_penelitian) ? dinamisObj.tgl_selesai_penelitian : '' %>" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs text-slate-800">
                    </div>
                </div>
            </div>

            <!-- 2. Fields for LMBR-PERSETUJUAN-WKT & UND- (Undangan Seminar / Ujian) -->
            <div id="field-seminar-jadwal" class="space-y-4 dynamic-section hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Jenis Seminar / Ujian *</label>
                    <select name="jenis_seminar" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800">
                        <option value="Seminar Proposal (Sempro)" <%= (dinamisObj && dinamisObj.jenis_seminar === 'Seminar Proposal (Sempro)') ? 'selected' : '' %>>Seminar Proposal (Sempro)</option>
                        <option value="Seminar Hasil (Semhas)" <%= (dinamisObj && dinamisObj.jenis_seminar === 'Seminar Hasil (Semhas)') ? 'selected' : '' %>>Seminar Hasil (Semhas)</option>
                        <option value="Sidang Akhir / Munaqasyah Skripsi" <%= (dinamisObj && dinamisObj.jenis_seminar === 'Sidang Akhir / Munaqasyah Skripsi') ? 'selected' : '' %>>Sidang Akhir / Munaqasyah Skripsi</option>
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label for="tu_edit_tanggal_ujian" class="block text-xs font-bold text-slate-700 mb-1">Tanggal Pelaksanaan *</label>
                        <div class="relative">
                            <input type="date" id="tu_edit_tanggal_ujian" name="tanggal_ujian" value="<%= (dinamisObj && (dinamisObj.tanggal_ujian || dinamisObj.tgl_ujian)) ? (dinamisObj.tanggal_ujian || dinamisObj.tgl_ujian) : '' %>"
                                onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800 cursor-pointer pr-10">
                            <button type="button" onclick="const el=document.getElementById('tu_edit_tanggal_ujian'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-600 hover:text-amber-700 p-1">
                                <i class="fa-solid fa-calendar-days text-sm"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label for="tu_edit_jam_mulai" class="block text-xs font-bold text-slate-700 mb-1">Jam Mulai Ujian *</label>
                        <div class="relative">
                            <input type="time" id="tu_edit_jam_mulai" name="jam_mulai" value="<%= (dinamisObj && dinamisObj.jam_mulai) ? dinamisObj.jam_mulai : '09:00' %>"
                                onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800 cursor-pointer pr-10">
                            <button type="button" onclick="const el=document.getElementById('tu_edit_jam_mulai'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-600 hover:text-amber-700 p-1">
                                <i class="fa-solid fa-clock text-sm"></i>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label for="tu_edit_jam_selesai" class="block text-xs font-bold text-slate-700 mb-1">Jam Selesai Ujian *</label>
                        <div class="relative">
                            <input type="time" id="tu_edit_jam_selesai" name="jam_selesai" value="<%= (dinamisObj && dinamisObj.jam_selesai) ? dinamisObj.jam_selesai : '11:00' %>"
                                onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800 cursor-pointer pr-10">
                            <button type="button" onclick="const el=document.getElementById('tu_edit_jam_selesai'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-600 hover:text-amber-700 p-1">
                                <i class="fa-solid fa-clock text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Ruang / Tempat Ujian *</label>
                    <input type="text" id="tu_edit_ruangan" name="ruangan" value="<%= (dinamisObj && (dinamisObj.ruangan || dinamisObj.bertempat_di)) ? (dinamisObj.ruangan || dinamisObj.bertempat_di) : 'Ruang Ujian & Seminar TI' %>" placeholder="Contoh: R. Teknik Informatika / Ruang Seminar FTI" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800">
                </div>
            </div>

            <!-- 3. Fields for SK-PEMBIMBING-PENGUJI & KARTU-BIMBINGAN -->
            <div id="field-sk-bimbingan" class="space-y-4 dynamic-section hidden">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Tahun Akademik / Semester</label>
                    <input type="text" name="tahun_akademik" value="<%= (dinamisObj && dinamisObj.tahun_akademik) ? dinamisObj.tahun_akademik : '' %>" placeholder="Contoh: 2025/2026 (Genap)" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-800">
                </div>
            </div>

            <!-- Default Info text -->
            <div id="field-default-info" class="p-3 bg-white rounded-xl border border-slate-200 text-xs text-slate-500 italic">
                Form isian spesifik untuk kategori surat ini siap diperbarui.
            </div>
        </div>

        <div>
            <label for="catatan" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Catatan Tambahan Surat</label>
            <textarea id="catatan" name="catatan" rows="2" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-semibold text-slate-800"><%= (dinamisObj && dinamisObj.catatan) ? dinamisObj.catatan : '' %></textarea>
        </div>


        <button type="submit" class="w-full py-3.5 px-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold rounded-xl text-xs shadow-lg transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-floppy-disk"></i> Simpan Perubahan Surat
        </button>
    </form>
</div>

<script>
    function setTuEditDateOption(offsetDays) {
        const d = new Date();
        if (offsetDays === 'next_monday') {
            const day = d.getDay();
            const diff = d.getDate() + (day === 0 ? 1 : 8 - day);
            d.setDate(diff);
        } else if (offsetDays === 'next_friday') {
            const day = d.getDay();
            const diff = d.getDate() + (day <= 5 ? 5 - day : 12 - day);
            d.setDate(diff);
        } else {
            d.setDate(d.getDate() + parseInt(offsetDays, 10));
        }
        if (document.getElementById('tu_edit_tanggal_ujian')) {
            document.getElementById('tu_edit_tanggal_ujian').value = d.toISOString().split('T')[0];
        }
    }

    function setTuEditTimeSession(start, end) {
        if (document.getElementById('tu_edit_jam_mulai')) document.getElementById('tu_edit_jam_mulai').value = start;
        if (document.getElementById('tu_edit_jam_selesai')) document.getElementById('tu_edit_jam_selesai').value = end;
    }

    function setTuEditRoomOption(roomName) {
        if (document.getElementById('tu_edit_ruangan')) document.getElementById('tu_edit_ruangan').value = roomName;
    }

    function toggleFormFields(selectEl) {
        const selectedOption = selectEl.options[selectEl.selectedIndex];
        const kode = selectedOption ? selectedOption.getAttribute('data-kode') : '';

        document.querySelectorAll('.dynamic-section').forEach(el => el.classList.add('hidden'));
        document.getElementById('field-default-info').classList.add('hidden');

        if (kode === 'SRT-IZIN-PENELITIAN') {
            document.getElementById('field-srt-izin-penelitian').classList.remove('hidden');
        } else if (kode === 'LMBR-PERSETUJUAN-WKT' || (kode && kode.startsWith('UND-'))) {
            document.getElementById('field-seminar-jadwal').classList.remove('hidden');
        } else if (kode === 'SK-PEMBIMBING-PENGUJI' || kode === 'KARTU-BIMBINGAN') {
            document.getElementById('field-sk-bimbingan').classList.remove('hidden');
        } else {
            document.getElementById('field-default-info').classList.remove('hidden');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const selectEl = document.getElementById('jenis_surat_id');
        if (selectEl) {
            toggleFormFields(selectEl);
        }
    });
</script>
