<% const prof = (typeof profile !== 'undefined' && profile) ? profile : ((typeof user !== 'undefined' && user && user.profile) ? user.profile : {}); %>

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Header Page -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-900">Profil Saya</h2>
            <p class="text-xs text-slate-500 mt-1">Kelola data informasi diri dan kata sandi akun E-Surat Administrasi TA.</p>
        </div>
        <a href="/dashboard" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Dashboard
        </a>
    </div>



    <!-- User Overview Card -->
    <div class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 p-6 md:p-8 rounded-3xl border border-slate-800 text-white shadow-xl flex flex-col sm:flex-row items-center gap-6">
        <div class="w-20 h-20 rounded-2xl bg-blue-600/30 border border-blue-400/40 text-amber-300 flex items-center justify-center text-3xl font-black shadow-inner shrink-0">
            <%= user ? user.username.substring(0, 2).toUpperCase() : 'US' %>
        </div>
        <div class="text-center sm:text-left space-y-1">
            <div class="flex items-center justify-center sm:justify-start gap-2">
                <h3 class="text-xl font-extrabold text-white"><%= (prof && prof.nama_lengkap) ? prof.nama_lengkap : (user ? user.username : 'User') %></h3>
                <span class="px-2.5 py-0.5 bg-blue-500/20 text-blue-300 border border-blue-400/30 text-[10px] font-extrabold rounded-full uppercase tracking-wider">
                    <%= user ? user.role : 'mahasiswa' %>
                </span>
            </div>
            <p class="text-xs text-slate-300 font-medium"><i class="fa-solid fa-envelope text-blue-400 mr-1"></i> <%= user ? user.email : '-' %></p>
            <% if (prof && prof.nim) { %>
                <p class="text-xs text-amber-300 font-mono font-bold"><i class="fa-solid fa-id-card text-amber-400 mr-1"></i> NIM: <%= prof.nim %></p>
            <% } %>
        </div>
    </div>

    <!-- Edit Profile Form -->
    <form action="/profile" method="POST" class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 space-y-6 shadow-xl">
        <h4 class="text-sm font-extrabold text-slate-900 border-b border-slate-200 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-user-pen text-blue-600"></i> Perbarui Informasi Diri
        </h4>

        <!-- Fields Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            
            <% if (user && user.role === 'mahasiswa') { %>
                <!-- NIM (Read-Only / Non-Editable) -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center justify-between">
                        <span>NIM / Stambuk</span>
                        <span class="text-[10px] text-amber-600 font-semibold lowercase italic"><i class="fa-solid fa-lock mr-1"></i>tidak dapat diubah</span>
                    </label>
                    <input type="text" value="<%= (prof && prof.nim) ? prof.nim : '' %>" disabled
                        class="w-full px-4 py-3 bg-slate-100 border border-slate-300 rounded-xl text-xs font-bold text-slate-500 cursor-not-allowed shadow-inner">
                </div>

                <!-- Nama Lengkap (Editable) -->
                <div>
                    <label for="nama_lengkap" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">Nama Lengkap *</label>
                    <input type="text" id="nama_lengkap" name="nama_lengkap" required value="<%= (prof && prof.nama_lengkap) ? prof.nama_lengkap : '' %>"
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900 transition">
                </div>

                <!-- Angkatan (Editable) -->
                <div>
                    <label for="angkatan" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">Angkatan Kuliah *</label>
                    <input type="number" id="angkatan" name="angkatan" required value="<%= (prof && prof.angkatan) ? prof.angkatan : 2022 %>"
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900 transition">
                </div>

                <!-- No HP / WA (Editable) -->
                <div>
                    <label for="no_hp" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">No. Telepon / WhatsApp *</label>
                    <input type="text" id="no_hp" name="no_hp" required value="<%= (prof && prof.no_hp) ? prof.no_hp : '' %>" placeholder="081234567890"
                        class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900 transition">
                </div>
            <% } %>

            <!-- Email System (Editable) -->
            <div class="<%= (user && user.role === 'mahasiswa') ? 'md:col-span-2' : '' %>">
                <label for="email" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">Alamat Email *</label>
                <input type="email" id="email" name="email" required value="<%= user ? user.email : '' %>"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900 transition">
            </div>
        </div>

        <!-- Section Change Password (Optional) -->
        <div class="pt-4 border-t border-slate-200 space-y-4">
            <h4 class="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-key text-amber-500"></i> Ubah Kata Sandi / Password (Opsional)
            </h4>
            <p class="text-[11px] text-slate-500">Biarkan kosong jika Anda tidak ingin mengubah password akun Anda saat ini.</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="password" class="block text-xs font-semibold text-slate-700 mb-1">Password Baru</label>
                    <input type="password" id="password" name="password" placeholder="Masukkan password baru..."
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs text-slate-900">
                </div>
                <div>
                    <label for="confirm_password" class="block text-xs font-semibold text-slate-700 mb-1">Konfirmasi Password Baru</label>
                    <input type="password" id="confirm_password" name="confirm_password" placeholder="Ulangi password baru..."
                        class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs text-slate-900">
                </div>
            </div>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 text-white font-extrabold rounded-xl text-xs shadow-lg shadow-blue-700/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
            <i class="fa-solid fa-floppy-disk text-amber-400"></i> Simpan Perubahan Profil
        </button>
    </form>
</div>
