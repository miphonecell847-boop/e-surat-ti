<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Otorisasi Keputusan Judul TA (Kaprodi)</h2>
            <p class="text-xs text-slate-500 mt-1">Ambil keputusan resmi persetujuan Judul Tugas Akhir: Diterima, Ditolak, atau Revisi.</p>
        </div>
        <a href="/dashboard" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
        </a>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 text-xs font-bold">
            <%= success %>
        </div>
    <% } %>

    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-4">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-100 uppercase text-slate-500 font-extrabold border-b border-slate-200">
                    <tr>
                        <th class="p-3">Mahasiswa</th>
                        <th class="p-3">Judul Usulan TA</th>
                        <th class="p-3">Dosen Pembimbing Fixed</th>
                        <th class="p-3">Status Saat Ini</th>
                        <th class="p-3">Keputusan Kaprodi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-medium">
                    <% proposals.forEach(p => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3">
                                <p class="font-bold text-slate-900"><%= p.mhs_nama %></p>
                                <p class="text-slate-500 font-mono">NIM: <%= p.nim %></p>
                            </td>
                            <td class="p-3 font-semibold text-slate-800 max-w-xs"><%= p.judul_ta %></td>
                            <td class="p-3 text-slate-700 text-[11px]">
                                <p><strong class="text-slate-900">P1:</strong> <%= p.pembimbing_1_nama %></p>
                                <p><strong class="text-slate-900">P2:</strong> <%= p.pembimbing_2_nama %></p>
                            </td>
                            <td class="p-3">
                                <% if (p.status === 'pending_kaprodi') { %>
                                    <span class="px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold">Pending Kaprodi</span>
                                <% } else if (p.status === 'diterima') { %>
                                    <span class="px-2.5 py-1 rounded-full bg-emerald-600 text-white text-[10px] font-bold">DITERIMA</span>
                                <% } else if (p.status === 'revisi') { %>
                                    <span class="px-2.5 py-1 rounded-full bg-amber-500 text-slate-950 text-[10px] font-bold">REVISI</span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full bg-rose-600 text-white text-[10px] font-bold"><%= p.status.toUpperCase() %></span>
                                <% } %>
                            </td>
                            <td class="p-3">
                                <% if (p.status === 'pending_kaprodi') { %>
                                    <form action="/kaprodi/persetujuan-judul" method="POST" class="space-y-2">
                                        <input type="hidden" name="proposal_id" value="<%= p.id %>">
                                        <input type="text" name="catatan_kaprodi" placeholder="Catatan Keputusan Kaprodi" class="w-full px-2.5 py-1 bg-slate-50 border border-slate-300 rounded text-xs">
                                        <div class="flex items-center gap-1.5">
                                            <button type="submit" name="status_decision" value="diterima" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded text-[10px]">
                                                <i class="fa-solid fa-check mr-1"></i> Diterima
                                            </button>
                                            <button type="submit" name="status_decision" value="revisi" class="px-2.5 py-1 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded text-[10px]">
                                                <i class="fa-solid fa-rotate-left mr-1"></i> Revisi
                                            </button>
                                            <button type="submit" name="status_decision" value="ditolak" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded text-[10px]">
                                                <i class="fa-solid fa-xmark mr-1"></i> Ditolak
                                            </button>
                                        </div>
                                    </form>
                                <% } else { %>
                                    <span class="text-slate-500 text-[11px] font-semibold">Keputusan Selesai</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</div>
