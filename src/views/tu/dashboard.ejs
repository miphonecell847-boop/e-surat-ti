<div class="space-y-6">
    <div class="bg-gradient-to-r from-blue-900/40 via-slate-900 to-slate-900 border border-blue-500/20 rounded-3xl p-6 shadow-xl flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-white mb-1">Dashboard Penomoran & Output PDF (Staff TU)</h2>
            <p class="text-xs text-slate-400">Penerbitan Nomor Surat Resmi Instansi, Pengoperasian PDF Engine, & Auto Archiving ke Google Drive.</p>
        </div>
        <div class="px-4 py-2 bg-blue-500/10 border border-blue-500/20 rounded-2xl text-blue-400 text-xs font-semibold">
            <i class="fa-solid fa-file-invoice mr-1"></i> Mode Staff Tata Usaha
        </div>
    </div>

    <!-- Table Pending TU -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-white">Surat Menunggu Penomoran Resmi & Penerbitan PDF</h3>
        </div>

        <% if (!pendingSurat || pendingSurat.length === 0) { %>
            <div class="p-12 text-center text-slate-500">
                <i class="fa-solid fa-file-circle-check text-4xl text-blue-400/40 mb-3"></i>
                <p class="text-sm">Tidak ada antrean penomoran surat saat ini.</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-950/60 text-xs font-semibold text-slate-400 uppercase border-b border-slate-800">
                        <tr>
                            <th class="px-6 py-3.5">Mahasiswa</th>
                            <th class="px-6 py-3.5">Jenis Surat</th>
                            <th class="px-6 py-3.5">Perihal</th>
                            <th class="px-6 py-3.5">Status E-Signature</th>
                            <th class="px-6 py-3.5 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        <% pendingSurat.forEach(surat => { %>
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="px-6 py-4">
                                    <span class="font-bold text-white block"><%= surat.mhs_nama %></span>
                                    <span class="text-xs text-indigo-400 font-mono">NIM: <%= surat.mhs_nim %></span>
                                </td>
                                <td class="px-6 py-4 font-semibold text-white">
                                    <%= surat.nama_surat %>
                                    <span class="block text-[10px] text-slate-400 font-mono"><%= surat.kode_surat %></span>
                                </td>
                                <td class="px-6 py-4 text-slate-300"><%= surat.perihal %></td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">
                                        <i class="fa-solid fa-stamp"></i> QR Verified
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a href="/tu/penomoran/<%= surat.id %>" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold transition shadow-md shadow-indigo-600/20">
                                        <i class="fa-solid fa-file-pdf mr-1"></i> Input Nomor & Terbitkan PDF
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>
