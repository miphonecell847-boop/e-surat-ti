<div class="w-full max-w-lg bg-slate-900/90 backdrop-blur-xl border border-slate-800 rounded-3xl p-8 shadow-2xl my-8">
    <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-blue-600/20 text-blue-400 border border-blue-500/30 mb-3 shadow-lg shadow-blue-500/20">
            <i class="fa-solid fa-user-graduate text-2xl"></i>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-white">Pendaftaran Akun Mahasiswa</h1>
        <p class="text-xs text-slate-400 mt-1">Sistem E-Surat Administrasi TA UNIDAYAN Baubau</p>
    </div>

    <!-- Info Box: Akun Dosen dibuat oleh Staff TU -->
    <div class="mb-5 p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start gap-2.5">
        <i class="fa-solid fa-circle-info text-base shrink-0 mt-0.5"></i>
        <span>Pendaftaran publik ini khusus untuk <strong>Mahasiswa</strong>. Akun Dosen dan Pengajar dibuat secara resmi oleh <strong>Staff TU Kampus</strong>.</span>
    </div>

    <% if (error) { %>
        <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs flex items-center gap-3">
            <i class="fa-solid fa-triangle-exclamation text-base"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <form action="/register" method="POST" class="space-y-4 text-xs">
        <input type="hidden" name="role" value="mahasiswa">

        <div>
            <label for="nama_lengkap" class="block font-semibold text-slate-300 uppercase mb-1">Nama Lengkap Mahasiswa *</label>
            <input type="text" id="nama_lengkap" name="nama_lengkap" required placeholder="Contoh: Ahmad Fauzi"
                class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100 placeholder-slate-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="nim" class="block font-semibold text-slate-300 uppercase mb-1">NIM Mahasiswa *</label>
                <input type="text" id="nim" name="nim" required placeholder="21081010001"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100 font-mono placeholder-slate-500">
            </div>
            <div>
                <label for="angkatan" class="block font-semibold text-slate-300 uppercase mb-1">Angkatan *</label>
                <input type="number" id="angkatan" name="angkatan" required value="2021" placeholder="2021"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100">
            </div>
        </div>

        <div>
            <label for="no_hp" class="block font-semibold text-slate-300 uppercase mb-1">No. HP / WhatsApp</label>
            <input type="text" id="no_hp" name="no_hp" placeholder="081234567890"
                class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100 placeholder-slate-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="username" class="block font-semibold text-slate-300 uppercase mb-1">Username Login *</label>
                <input type="text" id="username" name="username" required placeholder="Contoh: mhs_fauzi"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100 placeholder-slate-500">
            </div>
            <div>
                <label for="email" class="block font-semibold text-slate-300 uppercase mb-1">Email Aktif *</label>
                <input type="email" id="email" name="email" required placeholder="nama@univ.ac.id"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100 placeholder-slate-500">
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label for="password" class="block font-semibold text-slate-300 uppercase mb-1">Password *</label>
                <input type="password" id="password" name="password" required placeholder="••••••••"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100">
            </div>
            <div>
                <label for="confirm_password" class="block font-semibold text-slate-300 uppercase mb-1">Konfirmasi Password *</label>
                <input type="password" id="confirm_password" name="confirm_password" required placeholder="••••••••"
                    class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-blue-500 text-slate-100">
            </div>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold rounded-xl text-xs shadow-lg shadow-blue-600/30 transition transform hover:-translate-y-0.5 mt-2">
            <i class="fa-solid fa-user-plus mr-2"></i> Daftar Akun Mahasiswa (Kirim Ke Validasi Staff TU)
        </button>
    </form>

    <div class="mt-6 pt-4 border-t border-slate-800 text-center text-xs text-slate-400">
        Sudah memiliki akun? <a href="/login" class="text-amber-400 hover:underline font-bold">Masuk ke Sistem</a>
    </div>
</div>
