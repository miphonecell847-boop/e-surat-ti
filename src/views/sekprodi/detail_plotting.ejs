<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-slate-900">Verifikasi & Validasi Surat (Sekprodi)</h2>
            <p class="text-xs text-slate-500 mt-1">Mahasiswa: <span class="text-slate-900 font-extrabold"><%= pengajuan.mhs_nama %></span> (NIM: <%= pengajuan.mhs_nim %>)</p>
        </div>
        <a href="/sekprodi/dashboard" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Dashboard
        </a>
    </div>

    <!-- Main Form -->
    <form action="/sekprodi/verifikasi-surat/<%= pengajuan.id %>" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xl space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <div>
                <span class="px-2.5 py-0.5 bg-blue-100 text-blue-800 rounded font-mono text-[10px] font-bold"><%= pengajuan.kode_surat %></span>
                <h3 class="font-extrabold text-sm text-slate-900 mt-1"><%= pengajuan.nama_surat %></h3>
            </div>
            <button type="button" onclick="openPdfPreview('<%= pengajuan.id %>', '<%= pengajuan.nama_surat %>')" class="px-3 py-1.5 bg-blue-50 border border-blue-200 hover:bg-blue-100 text-blue-800 font-bold rounded-xl text-xs flex items-center gap-1.5">
                <i class="fa-solid fa-file-pdf text-blue-600"></i> Mode Preview PDF
            </button>
        </div>

        <div>
            <label for="catatan_sekprodi" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1">Catatan Verifikasi Sekprodi (Opsional)</label>
            <input type="text" id="catatan_sekprodi" name="catatan_sekprodi" placeholder="Misal: Berkas lengkap dan memenuhi standar prodi..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold">
        </div>

        <div class="p-5 bg-blue-50/70 border border-blue-200 rounded-2xl space-y-3">
            <label for="ttd_sekprodi" class="block text-xs font-extrabold text-blue-900 uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-file-signature text-blue-700"></i> Upload Tanda Tangan Digital Sekprodi (PNG/JPG Transparan)
            </label>
            <input type="file" id="ttd_sekprodi" name="ttd_sekprodi" accept="image/png, image/jpeg, image/jpg" class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white cursor-pointer">
        </div>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" name="action" value="approve" class="flex-1 py-3 px-4 bg-blue-700 hover:bg-blue-600 text-white font-extrabold rounded-xl text-xs shadow-lg transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-check text-amber-400"></i> Terima & Teruskan ke Kaprodi
            </button>
            <button type="submit" name="action" value="reject" onclick="return confirm('Apakah Anda yakin ingin mengembalikan surat ini ke Staff TU untuk revisi perbaikan?')" class="py-3 px-4 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-xs shadow flex items-center gap-1.5">
                <i class="fa-solid fa-rotate-left"></i> Kembalikan ke TU (Revisi)
            </button>
        </div>
    </form>
</div>
