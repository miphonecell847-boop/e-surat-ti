<div class="space-y-6">
    <!-- Success & Error Alerts -->
    <% if (typeof req !== 'undefined' && req.query && req.query.success) { %>
        <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-5 py-3.5 rounded-2xl text-xs flex items-center justify-between">
            <span><i class="fa-solid fa-circle-check mr-2"></i> <%= req.query.success %></span>
            <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
        </div>
    <% } %>

    <div class="bg-gradient-to-r from-emerald-900/40 via-slate-900 to-slate-900 border border-emerald-500/20 rounded-3xl p-6 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-bold text-white mb-1">Inbox Verification Dosen Pembimbing</h2>
            <p class="text-xs text-slate-400">
                Nama: <span class="text-emerald-400 font-semibold"><%= dosen ? dosen.nama_dosen : user.username %></span> | 
                NIP/NIDN: <span class="text-slate-300 font-semibold"><%= dosen ? dosen.nip_nidn : '-' %></span>
            </p>
            <p class="text-xs text-slate-400 mt-1 flex items-center gap-2">
                <i class="fa-brands fa-whatsapp text-emerald-400"></i> No. WhatsApp Notifikasi: 
                <% if (dosen && dosen.no_hp) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        <i class="fa-solid fa-circle-check text-[9px] mr-1"></i><%= dosen.no_hp %>
                    </span>
                <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        <i class="fa-solid fa-triangle-exclamation text-[9px] mr-1"></i>Belum diisi (Klik Ubah)
                    </span>
                <% } %>
                <button onclick="document.getElementById('modalEditWa').classList.remove('hidden')" class="text-xs text-indigo-400 hover:text-indigo-300 underline font-semibold ml-1">
                    <i class="fa-solid fa-pen-to-square"></i> Ubah Nomor WA
                </button>
            </p>
        </div>
        <div class="flex items-center gap-3">
            <div class="px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl text-emerald-400 text-xs font-semibold">
                <i class="fa-solid fa-chalkboard-user mr-1"></i> Mode Reviewer Bimbingan
            </div>
        </div>
    </div>

    <!-- Modal Edit Nomor WhatsApp Dosen -->
    <div id="modalEditWa" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="font-bold text-white text-base flex items-center gap-2">
                    <i class="fa-brands fa-whatsapp text-emerald-400 text-lg"></i> Pengaturan Nomor WhatsApp Notifikasi
                </h3>
                <button onclick="document.getElementById('modalEditWa').classList.add('hidden')" class="text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form action="/dosen/update-profile" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">Nomor WhatsApp Aktif</label>
                    <input type="text" name="no_hp" value="<%= dosen ? (dosen.no_hp || '') : '' %>" placeholder="Contoh: 081234567890" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                    <p class="text-[11px] text-slate-400 mt-1">Notifikasi Surat Undangan & SK TA akan dikirim langsung ke nomor WhatsApp ini.</p>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="document.getElementById('modalEditWa').classList.add('hidden')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl transition">
                        Batal
                    </button>
                    <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-emerald-600/30">
                        <i class="fa-solid fa-floppy-disk mr-1"></i> Simpan Nomor WA
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Inbox List -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
            <h3 class="font-bold text-sm text-white">Pengajuan Masuk Membutuhkan Persetujuan (Pembimbing 1 & 2)</h3>
        </div>

        <% const pendingAll = [...(pendingP1 || []), ...(pendingP2 || [])]; %>

        <% if (!pendingAll || pendingAll.length === 0) { %>
            <div class="p-12 text-center text-slate-500">
                <i class="fa-solid fa-circle-check text-4xl text-emerald-400/40 mb-3"></i>
                <p class="text-sm">Tidak ada pengajuan surat yang tertunda. Semua tugas bimbingan telah diproses!</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table data-paginate class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-950/60 text-xs font-semibold text-slate-400 uppercase border-b border-slate-800">
                        <tr>
                            <th class="px-6 py-3.5">Mahasiswa</th>
                            <th class="px-6 py-3.5">Jenis Surat</th>
                            <th class="px-6 py-3.5">Perihal</th>
                            <th class="px-6 py-3.5">Status Inbox</th>
                            <th class="px-6 py-3.5 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        <% pendingAll.forEach(surat => { %>
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="px-6 py-4">
                                    <span class="font-bold text-white block"><%= surat.mhs_nama %></span>
                                    <span class="text-xs text-indigo-400 font-mono">NIM: <%= surat.mhs_nim %></span>
                                </td>
                                <td class="px-6 py-4 font-semibold text-white">
                                    <%= surat.nama_surat %>
                                    <span class="block text-[10px] text-slate-400 font-mono"><%= surat.kode_surat %></span>
                                </td>
                                <td class="px-6 py-4 text-slate-300"><%= surat.perihal %></td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                        <i class="fa-solid fa-clock"></i> <%= surat.status.replace(/_/g, ' ').toUpperCase() %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a href="/dosen/review/<%= surat.id %>" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold transition shadow-md shadow-emerald-600/20">
                                        <i class="fa-solid fa-signature mr-1"></i> Review & Acc
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Arsip Surat Terbimbing Selesai (Tembusan Pembimbing 1 & 2) -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl space-y-4 p-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div>
                <h3 class="font-bold text-sm text-white flex items-center gap-2">
                    <i class="fa-solid fa-file-pdf text-emerald-400"></i> Arsip Surat Terbimbing Selesai (Tembusan Dosen Pembimbing 1 & 2)
                </h3>
                <p class="text-xs text-slate-400 mt-1">Daftar surat resmi mahasiswa terbimbing yang telah disetujui Kaprodi dan diberi penomoran resmi oleh TU.</p>
            </div>
        </div>

        <% if (!assignedSuratSelesai || assignedSuratSelesai.length === 0) { %>
            <div class="p-8 text-center text-slate-500 bg-slate-950/40 rounded-2xl border border-slate-800/80">
                <i class="fa-solid fa-folder-open text-3xl text-slate-600 mb-2"></i>
                <p class="text-xs">Belum ada surat terbimbing yang selesai diterbitkan.</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table data-paginate class="w-full text-left text-sm text-slate-300">
                    <thead class="bg-slate-950/60 text-xs font-semibold text-slate-400 uppercase border-b border-slate-800">
                        <tr>
                            <th class="px-4 py-3">Mahasiswa</th>
                            <th class="px-4 py-3">Jenis Surat</th>
                            <th class="px-4 py-3">Perihal</th>
                            <th class="px-4 py-3">Nomor Surat</th>
                            <th class="px-4 py-3 text-right">Preview / Unduh</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        <% assignedSuratSelesai.forEach(s => { %>
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="px-4 py-3">
                                    <span class="font-bold text-white block"><%= s.mhs_nama %></span>
                                    <span class="text-xs text-slate-400 font-mono">NIM: <%= s.mhs_nim %></span>
                                </td>
                                <td class="px-4 py-3 font-semibold text-white">
                                    <%= s.nama_surat %>
                                </td>
                                <td class="px-4 py-3 text-slate-300"><%= s.perihal %></td>
                                <td class="px-4 py-3 font-mono text-emerald-400 text-xs font-bold">
                                    <%= s.nomor_surat || '-' %>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <button onclick="openPdfPreview('<%= s.id %>', '<%= s.nama_surat %>')" class="px-3 py-1.5 bg-blue-600/20 border border-blue-500/30 hover:bg-blue-600/40 text-blue-300 font-bold rounded-xl text-xs flex items-center gap-1.5 ml-auto">
                                        <i class="fa-solid fa-file-pdf text-blue-400"></i> Pratinjau PDF
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal PDF Preview Interaktif -->
<div id="pdf-preview-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-4xl h-[90vh] rounded-3xl overflow-hidden shadow-2xl flex flex-col">
        <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-file-pdf text-amber-400 text-lg"></i>
                <h3 id="pdf-modal-title" class="font-extrabold text-sm">Preview Dokumen Surat PDF</h3>
            </div>
            <button onclick="closePdfPreview()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-xs font-bold transition">
                <i class="fa-solid fa-xmark mr-1"></i> Tutup Preview
            </button>
        </div>
        <div class="flex-1 bg-slate-100 relative">
            <iframe id="pdf-preview-iframe" class="w-full h-full border-0" src=""></iframe>
        </div>
    </div>
</div>

<script>
    function openPdfPreview(suratId, title) {
        document.getElementById('pdf-modal-title').innerText = 'Preview Dokumen: ' + title;
        document.getElementById('pdf-preview-iframe').src = '/surat/preview/' + suratId;
        document.getElementById('pdf-preview-modal').classList.remove('hidden');
    }
    function closePdfPreview() {
        document.getElementById('pdf-preview-modal').classList.add('hidden');
        document.getElementById('pdf-preview-iframe').src = '';
    }
</script>
