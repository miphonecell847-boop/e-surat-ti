<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Form Pembuatan Surat Permintaan (Staff TU)</h2>
            <p class="text-xs text-slate-500 mt-1">Terbitkan atau sesuaikan surat permintaan mahasiswa, lengkapi data spesifik, dan unggah TTD Digital Staff TU.</p>
        </div>
        <a href="/tu/daftar-surat" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Daftar Surat
        </a>
    </div>

    <% if (typeof prefilledData !== 'undefined' && prefilledData) { %>
        <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-900 text-xs font-bold flex items-center gap-3">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-600 text-lg"></i>
            <div>
                <p class="font-extrabold">Data Pengajuan Mahasiswa Terisi Otomatis!</p>
                <p class="font-medium text-[11px] text-amber-800">Form telah terisi otomatis sesuai data pengajuan mahasiswa. Silakan periksa atau lengkapi data sebelum diteruskan ke Sekprodi.</p>
            </div>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 text-xs font-bold flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-base"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <form action="/tu/buat-surat" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-6 shadow-xl">
        <input type="hidden" name="from_id" value="<%= prefilledData ? (prefilledData.from_id || '') : '' %>">
        <h3 class="text-sm font-black text-slate-900 border-b border-slate-200 pb-3 flex items-center gap-2">
            <i class="fa-solid fa-file-signature text-blue-700"></i> Informasi Permintaan Surat Baru
        </h3>

        <!-- Pilih Mahasiswa -->
        <div>
            <label for="mahasiswa_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Pilih Mahasiswa Pemohon *</label>
            <select id="mahasiswa_id" name="mahasiswa_id" required class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                <option value="" disabled <%= (!prefilledData) ? 'selected' : '' %>>-- Pilih Mahasiswa --</option>
                <% mahasiswaList.forEach(m => { %>
                    <option value="<%= m.id %>" <%= (prefilledData && prefilledData.mahasiswa_id == m.id) ? 'selected' : '' %>>
                        <%= m.nama_lengkap %> (NIM: <%= m.nim %> - Angkatan <%= m.angkatan %>)
                    </option>
                <% }); %>
            </select>
        </div>

        <!-- Pilih Jenis Surat -->
        <div>
            <label for="jenis_surat_id" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Pilih Kategori Jenis Surat *</label>
            <select id="jenis_surat_id" name="jenis_surat_id" required onchange="toggleTuFormFields(this)" class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                <option value="" disabled <%= (!prefilledData) ? 'selected' : '' %>>-- Pilih Jenis Surat --</option>
                <% jenisList.forEach(j => { %>
                    <option value="<%= j.id %>" data-kode="<%= j.kode_surat %>" <%= (prefilledData && prefilledData.jenis_surat_id == j.id) ? 'selected' : '' %>>
                        <%= j.nama_surat %> (<%= j.kode_surat %>)
                    </option>
                <% }); %>
            </select>
        </div>

        <!-- Tim Dosen Pembimbing -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 bg-blue-50/50 border border-blue-200/60 rounded-2xl">
            <div>
                <label for="pembimbing_1_id" class="block text-xs font-extrabold text-blue-900 uppercase tracking-wider mb-2">Dosen Pembimbing 1 (Utama) *</label>
                <select id="pembimbing_1_id" name="pembimbing_1_id" required class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                    <option value="" disabled selected>-- Pilih Pembimbing 1 --</option>
                    <% if (typeof dosenList !== 'undefined' && dosenList) { %>
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (prefilledData && prefilledData.pembimbing_1_id == d.id) ? 'selected' : '' %>>
                                <%= d.nama_dosen %> (<%= d.nip_nidn %>)
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div>
                <label for="pembimbing_2_id" class="block text-xs font-extrabold text-blue-900 uppercase tracking-wider mb-2">Dosen Pembimbing 2 (Pendamping) *</label>
                <select id="pembimbing_2_id" name="pembimbing_2_id" required class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
                    <option value="" disabled selected>-- Pilih Pembimbing 2 --</option>
                    <% if (typeof dosenList !== 'undefined' && dosenList) { %>
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (prefilledData && prefilledData.pembimbing_2_id == d.id) ? 'selected' : '' %>>
                                <%= d.nama_dosen %> (<%= d.nip_nidn %>)
                            </option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
        </div>

        <!-- Perihal Surat -->
        <div>
            <label for="perihal" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Perihal Surat *</label>
            <input type="text" id="perihal" name="perihal" required value="<%= prefilledData ? prefilledData.perihal : '' %>" placeholder="Contoh: Permohonan Surat Izin Penelitian Tugas Akhir di Dinas Kominfo"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900">
        </div>

        <!-- Data Dinamis Terstruktur Spesifik -->
        <div id="tu-dynamic-container" class="space-y-4 p-5 bg-slate-50 border border-slate-200 rounded-2xl">
            <h4 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1 flex items-center gap-2">
                <i class="fa-solid fa-list-check text-blue-600"></i> Detail Spesifikasi Informasi Surat
            </h4>

            <div id="tu-field-riset" class="space-y-3 tu-dynamic-section">
                <div>
                    <label for="instansi_tujuan" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1">Instansi / Perusahaan Tujuan</label>
                    <input type="text" id="instansi_tujuan" name="instansi_tujuan" value="<%= prefilledData ? (prefilledData.instansi_tujuan || prefilledData.tujuan_instansi || '') : '' %>" placeholder="Contoh: Kepala Dinas Komunikasi dan Informatika Kota Baubau"
                        class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-900">
                </div>
                <div>
                    <label for="alamat_instansi" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1">Alamat Instansi / Lokasi</label>
                    <input type="text" id="alamat_instansi" name="alamat_instansi" value="<%= prefilledData ? (prefilledData.alamat_instansi || '') : '' %>" placeholder="Contoh: Jl. Sultan Dayanu Ikhsanuddin No. 124, Baubau"
                        class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-bold text-slate-900">
                </div>
            </div>

            <div id="tu-field-jadwal" class="space-y-4 tu-dynamic-section">
                <div class="p-4 bg-amber-500/10 border border-amber-500/30 rounded-2xl space-y-4">
                    <span class="text-xs font-extrabold text-amber-900 uppercase flex items-center gap-2">
                        <i class="fa-solid fa-calendar-plus text-amber-600"></i> Saran / Usulan Jadwal Ujian Oleh Staff TU (Admin)
                    </span>
                    <p class="text-xs text-slate-600">
                        Admin dapat memasukkan usulan waktu & ruangan yang tersedia di bawah ini. Usulan ini akan diteruskan ke <strong>Dosen Pembimbing</strong> untuk dikonfirmasi/disesuaikan.
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-2 border-t border-amber-200">
                        <div>
                            <label for="tu_buat_tanggal_ujian" class="block text-[11px] font-extrabold text-slate-700 uppercase mb-1">Tanggal Ujian / Seminar *</label>
                            <div class="relative">
                                <input type="date" id="tu_buat_tanggal_ujian" name="tanggal_ujian" value="<%= prefilledData ? (prefilledData.tanggal_ujian || new Date().toISOString().split('T')[0]) : new Date().toISOString().split('T')[0] %>"
                                    onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                    class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl font-bold text-slate-900 cursor-pointer pr-10">
                                <button type="button" onclick="const el=document.getElementById('tu_buat_tanggal_ujian'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-600 hover:text-amber-700 p-1">
                                    <i class="fa-solid fa-calendar-days text-sm"></i>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label for="tu_buat_ruangan" class="block text-[11px] font-extrabold text-slate-700 uppercase mb-1">Ruangan / Tempat Ujian *</label>
                            <input type="text" id="tu_buat_ruangan" name="ruangan" value="<%= prefilledData ? (prefilledData.ruangan || prefilledData.bertempat_di || 'Ruang Ujian & Seminar TI') : 'Ruang Ujian & Seminar TI' %>" placeholder="Ruang Seminar Lantai 2" class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl font-bold text-slate-900">
                        </div>
                        <div>
                            <label for="tu_jam_mulai" class="block text-[11px] font-extrabold text-slate-700 uppercase mb-1">Jam Mulai *</label>
                            <div class="relative">
                                <input type="time" id="tu_jam_mulai" name="jam_mulai" value="<%= prefilledData ? (prefilledData.jam_mulai || '09:00') : '09:00' %>"
                                    onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                    class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl font-bold text-slate-900 cursor-pointer pr-10">
                                <button type="button" onclick="const el=document.getElementById('tu_jam_mulai'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-600 hover:text-amber-700 p-1">
                                    <i class="fa-solid fa-clock text-sm"></i>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label for="tu_jam_selesai" class="block text-[11px] font-extrabold text-slate-700 uppercase mb-1">Jam Selesai *</label>
                            <div class="relative">
                                <input type="time" id="tu_jam_selesai" name="jam_selesai" value="<%= prefilledData ? (prefilledData.jam_selesai || '11:00') : '11:00' %>"
                                    onclick="if (typeof this.showPicker === 'function') this.showPicker()"
                                    class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl font-bold text-slate-900 cursor-pointer pr-10">
                                <button type="button" onclick="const el=document.getElementById('tu_jam_selesai'); if(el && typeof el.showPicker==='function') el.showPicker(); else if(el) el.focus();" class="absolute right-3 top-1/2 -translate-y-1/2 text-amber-600 hover:text-amber-700 p-1">
                                    <i class="fa-solid fa-clock text-sm"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <label for="catatan" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Catatan Tambahan Surat</label>
            <textarea id="catatan" name="catatan" rows="2" placeholder="Catatan tambahan untuk surat..."
                class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-semibold text-slate-800"><%= prefilledData ? prefilledData.catatan : '' %></textarea>
        </div>

        <!-- Upload TTD Digital Staff TU -->
        <div class="p-5 bg-slate-50 border border-slate-200 rounded-2xl space-y-3">
            <label for="ttd_tu" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider">Unggah Spesimen Tanda Tangan Digital Staff TU (PNG/JPG Transparan)</label>
            <input type="file" id="ttd_tu" name="ttd_tu" accept="image/png, image/jpeg, image/jpg" class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white cursor-pointer">
            <p class="text-[11px] text-slate-500">Opsional: Gambar TTD digital akan disimpan dan digunakan pada penerbitan dokumen PDF resmi.</p>
        </div>

        <button type="submit" id="btn-submit-tu" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 text-white font-extrabold rounded-xl text-xs shadow-lg transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane text-amber-400"></i> Terbitkan & Diteruskan ke Dosen Pembimbing / Sekprodi
        </button>
    </form>
</div>

<script>
    function setTuPreset(start, end) {
        if (document.getElementById('tu_jam_mulai')) document.getElementById('tu_jam_mulai').value = start;
        if (document.getElementById('tu_jam_selesai')) document.getElementById('tu_jam_selesai').value = end;
    }

    function setTuBuatDateOption(offsetDays) {
        const d = new Date();
        if (offsetDays === 'next_monday') {
            const day = d.getDay();
            const diff = d.getDate() + (day === 0 ? 1 : 8 - day);
            d.setDate(diff);
        } else if (offsetDays === 'next_friday') {
            const day = d.getDay();
            const diff = d.getDate() + (day <= 5 ? 5 - day : 12 - day);
            d.setDate(diff);
        } else {
            d.setDate(d.getDate() + parseInt(offsetDays, 10));
        }
        if (document.getElementById('tu_buat_tanggal_ujian')) {
            document.getElementById('tu_buat_tanggal_ujian').value = d.toISOString().split('T')[0];
        }
    }

    function setTuBuatRoomOption(roomName) {
        if (document.getElementById('tu_buat_ruangan')) {
            document.getElementById('tu_buat_ruangan').value = roomName;
        }
    }

    function toggleTuFormFields(selectEl) {
        const selectedOption = selectEl.options[selectEl.selectedIndex];
        const kode = selectedOption ? selectedOption.getAttribute('data-kode') : '';
        const risetSec = document.getElementById('tu-field-riset');
        const jadwalSec = document.getElementById('tu-field-jadwal');
        const btnSubmit = document.getElementById('btn-submit-tu');

        if (kode === 'SRT-IZIN-PENELITIAN') {
            risetSec.classList.remove('hidden');
            jadwalSec.classList.add('hidden');
        } else if (kode === 'LMBR-PERSETUJUAN-WKT' || kode.startsWith('UND-') || kode === 'BA-UJIAN') {
            risetSec.classList.add('hidden');
            jadwalSec.classList.remove('hidden');
        } else {
            risetSec.classList.remove('hidden');
            jadwalSec.classList.remove('hidden');
        }

        if (kode === 'LMBR-PERSETUJUAN-WKT') {
            btnSubmit.innerHTML = '<i class="fa-solid fa-paper-plane text-amber-400"></i> Terbitkan Lembar Persetujuan Waktu & Diteruskan ke Dosen Pembimbing';
        } else {
            btnSubmit.innerHTML = '<i class="fa-solid fa-paper-plane text-amber-400"></i> Terbitkan & Diteruskan ke Sekprodi';
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const sel = document.getElementById('jenis_surat_id');
        if (sel && sel.value) toggleTuFormFields(sel);
    });
</script>
