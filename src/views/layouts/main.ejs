<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-100 text-slate-800">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'E-Surat TA - UNIDAYAN' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="h-full flex flex-col md:flex-row overflow-hidden bg-slate-100">

    <!-- Mobile Header -->
    <header class="md:hidden h-16 bg-slate-900 border-b border-slate-800 px-4 flex items-center justify-between shrink-0">
        <a href="https://www.unidayan.ac.id" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2" title="Buka www.unidayan.ac.id">
            <img src="/images/logo-unidayan.png" alt="UNIDAYAN" class="w-8 h-8 object-contain">
            <span class="font-bold text-sm text-white">E-Surat TA</span>
        </a>
        <button id="mobile-sidebar-toggle" class="p-2 text-slate-300 hover:text-white rounded-lg bg-slate-800">
            <i class="fa-solid fa-bars text-lg"></i>
        </button>
    </header>

    <!-- Sidebar Navigation (Academic Deep Navy) -->
    <aside id="app-sidebar" class="w-64 bg-slate-900 border-r border-slate-800 flex-col justify-between hidden md:flex shrink-0">
        <div>
            <!-- Brand Logo Desktop -->
            <div class="h-20 px-5 hidden md:flex items-center gap-3 border-b border-slate-800">
                <a href="https://www.unidayan.ac.id" target="_blank" rel="noopener noreferrer" class="group shrink-0" title="Buka Website Resmi UNIDAYAN Baubau (www.unidayan.ac.id)">
                    <img src="/images/logo-unidayan.png" alt="Logo UNIDAYAN" class="w-10 h-10 object-contain group-hover:scale-110 transition duration-300 drop-shadow">
                </a>
                <div>
                    <div class="flex items-center gap-1.5">
                        <h2 class="font-extrabold text-sm text-white tracking-tight leading-none">E-Surat TA</h2>
                        <span class="px-1.5 py-0.5 rounded text-[8px] font-extrabold bg-amber-400 text-slate-950">UNIDAYAN</span>
                    </div>
                    <span class="text-[10px] font-semibold text-slate-400">Teknik Informatika</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <%
                const curPath = typeof currentPath !== 'undefined' ? currentPath : '';
                function checkIsActive(targetPath) {
                    if (targetPath === '/') return curPath === '/';
                    if (targetPath === '/dashboard') {
                        return curPath === '/dashboard' || curPath.endsWith('/dashboard');
                    }
                    return curPath === targetPath || (targetPath !== '/' && curPath.startsWith(targetPath));
                }
            %>
            <nav class="p-4 space-y-1.5 text-sm font-medium">
                <a href="/" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                    <span class="flex items-center gap-3"><i class="fa-solid fa-house w-5 text-center <%= checkIsActive('/') ? 'text-amber-300' : 'text-amber-400' %>"></i> Halaman Utama</span>
                    <% if (checkIsActive('/')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                </a>

                <a href="/dashboard" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/dashboard') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                    <span class="flex items-center gap-3"><i class="fa-solid fa-gauge w-5 text-center <%= checkIsActive('/dashboard') ? 'text-amber-300' : 'text-amber-400' %>"></i> Dashboard</span>
                    <% if (checkIsActive('/dashboard')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                </a>

                <% if (user && user.role === 'mahasiswa') { %>
                    <a href="/mahasiswa/pengajuan-judul" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/mahasiswa/pengajuan-judul') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-book-bookmark w-5 text-center <%= checkIsActive('/mahasiswa/pengajuan-judul') ? 'text-amber-300' : 'text-amber-400' %>"></i> Pengajuan Judul TA</span>
                        <% if (checkIsActive('/mahasiswa/pengajuan-judul')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/mahasiswa/buat-surat" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/mahasiswa/buat-surat') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-paper-plane w-5 text-center <%= checkIsActive('/mahasiswa/buat-surat') ? 'text-amber-300' : 'text-blue-400' %>"></i> Pengajuan Surat</span>
                        <% if (checkIsActive('/mahasiswa/buat-surat')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/mahasiswa/jadwal-ujian" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/mahasiswa/jadwal-ujian') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-calendar-days w-5 text-center <%= checkIsActive('/mahasiswa/jadwal-ujian') ? 'text-amber-300' : 'text-amber-400' %>"></i> Jadwal Ujian & Seminar</span>
                        <% if (checkIsActive('/mahasiswa/jadwal-ujian')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                <% } %>

                <% if (user && user.role === 'dosen') { %>
                    <a href="/dosen/dashboard" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/dosen/dashboard') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-inbox w-5 text-center <%= checkIsActive('/dosen/dashboard') ? 'text-amber-300' : 'text-emerald-400' %>"></i> Inbox Approval</span>
                        <% if (checkIsActive('/dosen/dashboard')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/dosen/konfirmasi-bimbingan" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/dosen/konfirmasi-bimbingan') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-bell w-5 text-center <%= checkIsActive('/dosen/konfirmasi-bimbingan') ? 'text-amber-300' : 'text-amber-400' %>"></i> Konfirmasi Bimbingan</span>
                        <% if (checkIsActive('/dosen/konfirmasi-bimbingan')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/mahasiswa/jadwal-ujian" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/mahasiswa/jadwal-ujian') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-calendar-days w-5 text-center <%= checkIsActive('/mahasiswa/jadwal-ujian') ? 'text-amber-300' : 'text-purple-400' %>"></i> Jadwal Ujian Mahasiswa</span>
                        <% if (checkIsActive('/mahasiswa/jadwal-ujian')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                <% } %>

                <% if (user && user.role === 'sekretaris_prodi') { %>
                    <a href="/sekprodi/daftar-surat" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/sekprodi/daftar-surat') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-list-check w-5 text-center <%= checkIsActive('/sekprodi/daftar-surat') ? 'text-amber-300' : 'text-cyan-400' %>"></i> Daftar Menu Surat (10 Kategori)</span>
                        <% if (checkIsActive('/sekprodi/daftar-surat')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/sekprodi/dashboard" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/sekprodi/dashboard') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-user-check w-5 text-center <%= checkIsActive('/sekprodi/dashboard') ? 'text-amber-300' : 'text-amber-400' %>"></i> Validasi & Ploting</span>
                        <% if (checkIsActive('/sekprodi/dashboard')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/sekprodi/verifikasi-judul" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/sekprodi/verifikasi-judul') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-book-bookmark w-5 text-center <%= checkIsActive('/sekprodi/verifikasi-judul') ? 'text-amber-300' : 'text-blue-400' %>"></i> Validasi Judul TA</span>
                        <% if (checkIsActive('/sekprodi/verifikasi-judul')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                <% } %>

                <% if (user && user.role === 'kaprodi') { %>
                    <a href="/kaprodi/daftar-surat" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/kaprodi/daftar-surat') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-list-check w-5 text-center <%= checkIsActive('/kaprodi/daftar-surat') ? 'text-amber-300' : 'text-purple-400' %>"></i> Daftar Menu Surat (10 Kategori)</span>
                        <% if (checkIsActive('/kaprodi/daftar-surat')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/kaprodi/dashboard" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/kaprodi/dashboard') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-signature w-5 text-center <%= checkIsActive('/kaprodi/dashboard') ? 'text-amber-300' : 'text-emerald-400' %>"></i> Otorisasi & E-Signature</span>
                        <% if (checkIsActive('/kaprodi/dashboard')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/kaprodi/persetujuan-judul" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/kaprodi/persetujuan-judul') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-gavel w-5 text-center <%= checkIsActive('/kaprodi/persetujuan-judul') ? 'text-amber-300' : 'text-amber-400' %>"></i> Persetujuan Judul TA</span>
                        <% if (checkIsActive('/kaprodi/persetujuan-judul')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                <% } %>

                <% if (user && (user.role === 'staff_tu' || user.role === 'stafftu')) { %>
                    <a href="/tu/kelola-akun" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/tu/kelola-akun') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-user-gear w-5 text-center <%= checkIsActive('/tu/kelola-akun') ? 'text-amber-300' : 'text-amber-400' %>"></i> Kelola & Validasi Akun</span>
                        <% if (checkIsActive('/tu/kelola-akun')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/tu/daftar-surat" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/tu/daftar-surat') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-list-check w-5 text-center <%= checkIsActive('/tu/daftar-surat') ? 'text-amber-300' : 'text-cyan-400' %>"></i> Daftar Menu Surat (10 Kategori)</span>
                        <% if (checkIsActive('/tu/daftar-surat')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/tu/buat-surat" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/tu/buat-surat') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-file-circle-plus w-5 text-center <%= checkIsActive('/tu/buat-surat') ? 'text-amber-300' : 'text-blue-400' %>"></i> Buat Surat Permintaan</span>
                        <% if (checkIsActive('/tu/buat-surat')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/tu/dashboard" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/tu/dashboard') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-file-pdf w-5 text-center <%= checkIsActive('/tu/dashboard') ? 'text-amber-300' : 'text-emerald-400' %>"></i> Penomoran & Output PDF</span>
                        <% if (checkIsActive('/tu/dashboard')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                    <a href="/tu/verifikasi-judul" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/tu/verifikasi-judul') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                        <span class="flex items-center gap-3"><i class="fa-solid fa-file-check w-5 text-center <%= checkIsActive('/tu/verifikasi-judul') ? 'text-amber-300' : 'text-purple-400' %>"></i> Verifikasi Judul TA</span>
                        <% if (checkIsActive('/tu/verifikasi-judul')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                    </a>
                <% } %>


                <a href="/profile" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/profile') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                    <span class="flex items-center gap-3"><i class="fa-solid fa-circle-user w-5 text-center <%= checkIsActive('/profile') ? 'text-amber-300' : '' %>"></i> Profil Saya</span>
                    <% if (checkIsActive('/profile')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                </a>

                <a href="/change-password" class="flex items-center justify-between px-4 py-3 rounded-2xl transition-all duration-200 <%= checkIsActive('/change-password') ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]' : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/80' %>">
                    <span class="flex items-center gap-3"><i class="fa-solid fa-key w-5 text-center <%= checkIsActive('/change-password') ? 'text-amber-300' : '' %>"></i> Ganti Password</span>
                    <% if (checkIsActive('/change-password')) { %><span class="w-2 h-2 rounded-full bg-amber-300 shadow-sm shadow-amber-300"></span><% } %>
                </a>

                <a href="https://www.unidayan.ac.id" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-4 py-3 rounded-xl text-amber-400 hover:text-amber-300 hover:bg-slate-800/80 transition">
                    <i class="fa-solid fa-globe w-5 text-center"></i> Web UNIDAYAN
                </a>
            </nav>
        </div>

        <!-- User Badge & Logout Footer -->
        <div class="p-4 border-t border-slate-800 bg-slate-950/60">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 overflow-hidden">
                    <div class="w-9 h-9 rounded-full bg-blue-900 border border-amber-400/30 flex items-center justify-center text-xs font-bold text-amber-400 shrink-0">
                        <%= user ? user.username.substring(0,2).toUpperCase() : 'US' %>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-bold text-slate-200 truncate"><%= user ? user.username : 'User' %></p>
                        <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-300 uppercase tracking-wide">
                            <%= user ? user.role.replace('_', ' ') : 'Role' %>
                        </span>
                    </div>
                </div>
                <a href="/logout" title="Logout" class="text-slate-400 hover:text-rose-400 transition p-2">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Desktop Academic Header -->
        <header class="h-20 bg-slate-900 border-b border-slate-800 px-6 hidden md:flex items-center justify-between text-white">
            <div class="flex items-center gap-3">
                <h1 class="font-extrabold text-base tracking-tight text-white"><%= title %></h1>
            </div>

            <div class="flex items-center gap-3">
                <a href="https://www.unidayan.ac.id" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-amber-400 hover:underline flex items-center gap-1.5 bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800">
                    <i class="fa-solid fa-globe"></i> www.unidayan.ac.id
                </a>
                <span class="text-xs text-slate-300 flex items-center gap-2 bg-slate-950 px-3.5 py-2 rounded-xl border border-slate-800 shadow-inner">
                    <i class="fa-brands fa-google-drive text-emerald-400"></i> Google Drive Cloud: Connected
                </span>
            </div>
        </header>

        <!-- Dynamic Body Page Content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6 bg-slate-100 text-slate-800">
            <%- body %>
        </main>
    </div>

    <script>
        const btn = document.getElementById('mobile-sidebar-toggle');
        const sidebar = document.getElementById('app-sidebar');
        if (btn && sidebar) {
            btn.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('flex');
            });
        }

        // Automatic Client-side Active Sidebar Menu Highlighter
        document.addEventListener("DOMContentLoaded", function() {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('nav a');
            
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (!href || href === '#') return;

                let isActive = false;
                if (href === '/') {
                    isActive = (currentPath === '/');
                } else if (href === '/dashboard') {
                    isActive = (currentPath === '/dashboard' || currentPath.endsWith('/dashboard'));
                } else {
                    isActive = (currentPath === href || (href !== '/' && currentPath.startsWith(href)));
                }

                if (isActive) {
                    link.className = "flex items-center justify-between px-4 py-3 rounded-2xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg shadow-blue-600/30 border border-blue-400/40 scale-[1.02]";
                    if (!link.querySelector('.active-dot-indicator')) {
                        const dot = document.createElement('span');
                        dot.className = "w-2.5 h-2.5 rounded-full bg-amber-300 shadow-md shadow-amber-300 active-dot-indicator";
                        link.appendChild(dot);
                    }
                } else {
                    link.className = "flex items-center justify-between px-4 py-3 rounded-2xl text-slate-400 hover:text-slate-100 hover:bg-slate-800/80 transition-all duration-200";
                    const dot = link.querySelector('.active-dot-indicator');
                    if (dot) dot.remove();
                }
            });
        });
    </script>
</body>
</html>
