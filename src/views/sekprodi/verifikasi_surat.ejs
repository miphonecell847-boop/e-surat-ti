<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Verifikasi & Validasi Surat (Sekprodi)</h2>
            <p class="text-xs text-slate-500 mt-1">Periksa kelayakan berkas pengajuan surat dan bubuhkan Tanda Tangan Digital Sekprodi.</p>
        </div>
        <a href="/sekprodi/daftar-surat" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Daftar Surat
        </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-600 text-xs font-bold flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-base"></i>
            <span><%= error %></span>
        </div>
    <% } %>

    <!-- Detail Surat & Mahasiswa -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <div>
                <span class="px-2.5 py-0.5 bg-blue-100 text-blue-800 rounded font-mono text-[10px] font-bold"><%= pengajuan.kode_surat %></span>
                <h3 class="font-extrabold text-sm text-slate-900 mt-1"><%= pengajuan.nama_surat %></h3>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="openPdfPreview('<%= pengajuan.id %>', '<%= pengajuan.nama_surat %>')" class="px-3 py-1.5 bg-blue-50 border border-blue-200 hover:bg-blue-100 text-blue-800 font-bold rounded-xl text-xs flex items-center gap-1.5">
                    <i class="fa-solid fa-file-pdf text-blue-600"></i> Mode Preview PDF
                </button>
                <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-extrabold uppercase"><%= pengajuan.status %></span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
                <p class="text-slate-500 font-bold uppercase text-[10px]">Mahasiswa Pemohon:</p>
                <p class="font-extrabold text-slate-900"><%= pengajuan.mhs_nama %> (NIM: <%= pengajuan.mhs_nim %>)</p>
            </div>
            <div>
                <p class="text-slate-500 font-bold uppercase text-[10px]">Perihal Surat:</p>
                <p class="font-extrabold text-slate-900"><%= pengajuan.perihal %></p>
            </div>
        </div>

        <!-- Form Verifikasi & Upload TTD Digital Sekprodi -->
        <% if (pengajuan.status === 'pending_sekprodi') { %>
            <form action="/sekprodi/verifikasi-surat/<%= pengajuan.id %>" method="POST" enctype="multipart/form-data" class="pt-4 border-t border-slate-200 space-y-4">
                <div>
                    <label for="catatan_sekprodi" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-1">Catatan Validasi Sekprodi (Opsional)</label>
                    <input type="text" id="catatan_sekprodi" name="catatan_sekprodi" placeholder="Misal: Berkas lengkap dan memenuhi standar prodi..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold">
                </div>

                <div class="p-5 bg-blue-50/70 border border-blue-200 rounded-2xl space-y-3">
                    <label for="ttd_sekprodi" class="block text-xs font-extrabold text-blue-900 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-file-signature text-blue-700"></i> Upload Tanda Tangan Digital Sekprodi (PNG/JPG Transparan)
                    </label>
                    <input type="file" id="ttd_sekprodi" name="ttd_sekprodi" accept="image/png, image/jpeg, image/jpg" class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white cursor-pointer">
                    <p class="text-[11px] text-blue-700 font-medium">Gambar TTD digital Sekprodi ini akan otomatis disematkan pada dokumen PDF resmi saat dicetak.</p>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" name="action" value="approve" class="flex-1 py-3 px-4 bg-blue-700 hover:bg-blue-600 text-white font-extrabold rounded-xl text-xs shadow-lg transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check text-amber-400"></i> Terima & Teruskan ke Kaprodi
                    </button>
                    <button type="submit" name="action" value="reject" onclick="return confirm('Apakah Anda yakin ingin mengembalikan surat ini ke Staff TU untuk revisi perbaikan?')" class="py-3 px-4 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-xl text-xs shadow flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate-left"></i> Kembalikan ke TU (Revisi)
                    </button>
                </div>
            </form>
        <% } else { %>
            <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-xs text-slate-600 font-semibold">
                Status berkas ini: <strong class="uppercase text-slate-900"><%= pengajuan.status %></strong>. Pengajuan telah selesai diverifikasi oleh Sekprodi.
            </div>
        <% } %>
    </div>
</div>

<!-- Modal PDF Preview Interaktif -->
<div id="pdf-preview-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-4xl h-[90vh] rounded-3xl overflow-hidden shadow-2xl flex flex-col">
        <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-file-pdf text-amber-400 text-lg"></i>
                <h3 id="pdf-modal-title" class="font-extrabold text-sm">Preview Dokumen Surat PDF</h3>
            </div>
            <button onclick="closePdfPreview()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-xs font-bold transition">
                <i class="fa-solid fa-xmark mr-1"></i> Tutup Preview
            </button>
        </div>
        <div class="flex-1 bg-slate-100 relative">
            <iframe id="pdf-preview-iframe" class="w-full h-full border-0" src=""></iframe>
        </div>
    </div>
</div>

<script>
    function openPdfPreview(suratId, title) {
        document.getElementById('pdf-modal-title').innerText = 'Preview Dokumen: ' + title;
        document.getElementById('pdf-preview-iframe').src = '/surat/preview/' + suratId;
        document.getElementById('pdf-preview-modal').classList.remove('hidden');
    }
    function closePdfPreview() {
        document.getElementById('pdf-preview-modal').classList.add('hidden');
        document.getElementById('pdf-preview-iframe').src = '';
    }
</script>
