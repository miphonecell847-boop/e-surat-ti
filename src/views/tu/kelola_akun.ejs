<div class="max-w-7xl mx-auto space-y-6">
    <!-- Header Page -->
    <div class="bg-slate-900 rounded-2xl p-6 border border-slate-800 text-white shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30 mb-2">
                <i class="fa-solid fa-user-shield"></i> Otoritas Staff TU Kampus
            </span>
            <h1 class="text-2xl font-extrabold tracking-tight text-white">Manajemen & Validasi Akun Pengguna</h1>
            <p class="text-sm text-slate-400 mt-1">Validasi pendaftaran mandiri mahasiswa serta pembuatan akun Dosen & Mahasiswa baru oleh Staff TU.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/tu/dashboard" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl font-semibold text-sm transition flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Success / Error -->
    <% if (success) { %>
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-xl"></i>
            <span class="text-sm font-semibold"><%= success %></span>
        </div>
    <% } %>

    <% if (error) { %>
        <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 flex items-center gap-3">
            <i class="fa-solid fa-circle-exclamation text-xl"></i>
            <span class="text-sm font-semibold"><%= error %></span>
        </div>
    <% } %>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl shrink-0">
                <i class="fa-solid fa-user-clock"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Menunggu Validasi</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= pendingList.length %></h3>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl shrink-0">
                <i class="fa-solid fa-user-graduate"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Mahasiswa Aktif</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= allUsers.filter(u => u.role === 'mahasiswa' && u.status === 'active').length %></h3>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl shrink-0">
                <i class="fa-solid fa-user-tie"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Dosen Pengajar</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= allUsers.filter(u => u.role === 'dosen' || u.role === 'kaprodi' || u.role === 'sekretaris_prodi').length %></h3>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl shrink-0">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Pengguna</p>
                <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= allUsers.length %></h3>
            </div>
        </div>
    </div>

    <!-- Section 1: Permohonan Validasi Pendaftaran Mahasiswa -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center text-sm font-bold">
                    <i class="fa-solid fa-user-check"></i>
                </div>
                <div>
                    <h2 class="font-extrabold text-slate-900">Permohonan Registrasi Mandiri Mahasiswa</h2>
                    <p class="text-xs text-slate-500">Mahasiswa yang telah mendaftar mandiri di web kampus memerlukan validasi Staff TU untuk dapat login.</p>
                </div>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-extrabold bg-amber-100 text-amber-800 border border-amber-300">
                <%= pendingList.length %> Perlu Di-Validasi
            </span>
        </div>

        <% if (pendingList.length === 0) { %>
            <div class="p-8 text-center">
                <i class="fa-solid fa-circle-check text-4xl text-emerald-500 mb-3"></i>
                <p class="text-sm font-bold text-slate-700">Tidak ada permohonan registrasi yang pending.</p>
                <p class="text-xs text-slate-500 mt-1">Semua pendaftaran mahasiswa telah diproses dan divalidasi oleh Staff TU.</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-100/70 border-b border-slate-200 text-xs font-bold text-slate-600 uppercase tracking-wider">
                            <th class="p-4">Mahasiswa</th>
                            <th class="p-4">NIM</th>
                            <th class="p-4">Angkatan</th>
                            <th class="p-4">Kontak & Email</th>
                            <th class="p-4">Tanggal Daftar</th>
                            <th class="p-4 text-center">Tindakan Validasi TU</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 text-sm">
                        <% pendingList.forEach(mhs => { %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-4">
                                    <div class="font-bold text-slate-900"><%= mhs.nama_lengkap %></div>
                                    <div class="text-xs text-slate-500 font-mono">@<%= mhs.username %></div>
                                </td>
                                <td class="p-4 font-mono font-bold text-slate-800"><%= mhs.nim %></td>
                                <td class="p-4 text-slate-700 font-semibold"><%= mhs.angkatan %></td>
                                <td class="p-4">
                                    <div class="text-xs font-medium text-slate-800"><%= mhs.email %></div>
                                    <div class="text-xs text-slate-500"><%= mhs.no_hp || '-' %></div>
                                </td>
                                <td class="p-4 text-xs text-slate-500"><%= new Date(mhs.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                                <td class="p-4">
                                    <div class="flex items-center justify-center gap-2">
                                        <form action="/tu/approve-user/<%= mhs.user_id %>" method="POST" onsubmit="return confirm('Validasi dan aktifkan akun mahasiswa ini?');">
                                            <button type="submit" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-sm transition flex items-center gap-1.5">
                                                <i class="fa-solid fa-check"></i> Validasi & Setujui
                                            </button>
                                        </form>
                                        <form action="/tu/reject-user/<%= mhs.user_id %>" method="POST" onsubmit="return confirm('Tolak permohonan registrasi ini? Data akan dihapus.');">
                                            <button type="submit" class="px-3 py-2 bg-rose-100 hover:bg-rose-200 text-rose-700 rounded-xl font-bold text-xs transition flex items-center gap-1">
                                                <i class="fa-solid fa-xmark"></i> Tolak
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Section 2: Form Buat Akun Langsung oleh Staff TU -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Form Buat Akun Dosen -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
                <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-base font-bold">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div>
                    <h3 class="font-extrabold text-slate-900">Buat Akun Dosen Baru</h3>
                    <p class="text-xs text-slate-500">Akun Dosen yang dibuat Staff TU akan langsung aktif.</p>
                </div>
            </div>

            <form action="/tu/buat-akun-dosen" method="POST" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">NIP / NIDN Dosen *</label>
                    <input type="text" name="nip_nidn" required placeholder="Contoh: 198501012010121001" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap & Gelar *</label>
                    <input type="text" name="nama_dosen" required placeholder="Contoh: Dr. Ir. Budi Santoso, M.T." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Jabatan Dosen</label>
                    <input type="text" name="jabatan" placeholder="Contoh: Lektor / Dosen Pengajar" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Username Login *</label>
                        <input type="text" name="username" required placeholder="Username" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Email *</label>
                        <input type="email" name="email" required placeholder="dosen@univ.ac.id" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Password Initial *</label>
                    <input type="password" name="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-sm shadow-sm transition flex items-center justify-center gap-2 mt-2">
                    <i class="fa-solid fa-user-check"></i> Buat & Aktifkan Akun Dosen
                </button>
            </form>
        </div>

        <!-- Form Buat Akun Mahasiswa -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 space-y-4">
            <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
                <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-base font-bold">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
                <div>
                    <h3 class="font-extrabold text-slate-900">Buat Akun Mahasiswa Baru</h3>
                    <p class="text-xs text-slate-500">Buat akun mahasiswa secara langsung tanpa pendaftaran mandiri.</p>
                </div>
            </div>

            <form action="/tu/buat-akun-mahasiswa" method="POST" class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">NIM Mahasiswa *</label>
                        <input type="text" name="nim" required placeholder="Contoh: 21081010001" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Angkatan *</label>
                        <input type="number" name="angkatan" required value="2021" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap Mahasiswa *</label>
                    <input type="text" name="nama_lengkap" required placeholder="Contoh: Ahmad Fauzi" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">No WhatsApp / HP</label>
                    <input type="text" name="no_hp" placeholder="081234567890" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Username *</label>
                        <input type="text" name="username" required placeholder="Username" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Email *</label>
                        <input type="email" name="email" required placeholder="mhs@univ.ac.id" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Password Initial *</label>
                    <input type="password" name="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-sm shadow-sm transition flex items-center justify-center gap-2 mt-2">
                    <i class="fa-solid fa-user-check"></i> Buat & Aktifkan Akun Mahasiswa
                </button>
            </form>
        </div>
    </div>

    <!-- Section 3: Daftar Seluruh Pengguna Sistem -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-slate-800 text-white flex items-center justify-center text-sm font-bold">
                    <i class="fa-solid fa-address-book"></i>
                </div>
                <div>
                    <h2 class="font-extrabold text-slate-900">Daftar Seluruh Pengguna Sistem E-Surat</h2>
                    <p class="text-xs text-slate-500">Kelola akun aktif, status perizinan, dan penghapusan pengguna.</p>
                </div>
            </div>
            <span class="text-xs font-bold text-slate-500"><%= allUsers.length %> Pengguna Terdaftar</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-100/70 border-b border-slate-200 text-xs font-bold text-slate-600 uppercase tracking-wider">
                        <th class="p-4">Pengguna & Role</th>
                        <th class="p-4">Identitas / Profil</th>
                        <th class="p-4">Email</th>
                        <th class="p-4 text-center">Status Akun</th>
                        <th class="p-4 text-center">Opsi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-sm">
                    <% allUsers.forEach(u => { %>
                        <tr class="hover:bg-slate-50 transition">
                            <td class="p-4">
                                <div class="font-bold text-slate-900"><%= u.username %></div>
                                <% if (u.role === 'mahasiswa') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">Mahasiswa</span>
                                <% } else if (u.role === 'dosen') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">Dosen Pengajar</span>
                                <% } else if (u.role === 'sekretaris_prodi') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-cyan-100 text-cyan-800">Sekretaris Prodi</span>
                                <% } else if (u.role === 'kaprodi') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800">Ketua Prodi</span>
                                <% } else if (u.role === 'staff_tu') { %>
                                    <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Staff TU</span>
                                <% } %>
                            </td>
                            <td class="p-4">
                                <% if (u.profile && u.profile.nama_lengkap) { %>
                                    <div class="font-semibold text-slate-800"><%= u.profile.nama_lengkap %></div>
                                    <div class="text-xs text-slate-500 font-mono">NIM: <%= u.profile.nim %> (Angkatan <%= u.profile.angkatan %>)</div>
                                <% } else if (u.profile && u.profile.nama_dosen) { %>
                                    <div class="font-semibold text-slate-800"><%= u.profile.nama_dosen %></div>
                                    <div class="text-xs text-slate-500 font-mono">NIP/NIDN: <%= u.profile.nip_nidn %></div>
                                <% } else { %>
                                    <span class="text-xs text-slate-400 font-italic">Staf Administrasi System</span>
                                <% } %>
                            </td>
                            <td class="p-4 text-xs font-mono text-slate-700"><%= u.email %></td>
                            <td class="p-4 text-center">
                                <% if (u.status === 'active' || u.is_active === 1) { %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                        <i class="fa-solid fa-circle-check"></i> Aktif
                                    </span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-amber-100 text-amber-800 border border-amber-300">
                                        <i class="fa-solid fa-clock"></i> Pending Validasi
                                    </span>
                                <% } %>
                            </td>
                            <td class="p-4 text-center">
                                <% if (u.id !== user.id) { %>
                                    <form action="/tu/hapus-user/<%= u.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus akun ini secara permanen?');">
                                        <button type="submit" title="Hapus Akun" class="p-2 text-rose-600 hover:bg-rose-50 rounded-lg transition">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-xs text-slate-400 italic">Akun Anda</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
