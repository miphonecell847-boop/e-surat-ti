<div class="max-w-5xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-extrabold text-slate-900">Pengajuan Judul Tugas Akhir / Skripsi</h2>
            <p class="text-xs text-slate-500 mt-1">Formulir pengajuan usulan judul TA dan usulan Dosen Pembimbing 1 & 2.</p>
        </div>
        <a href="/dashboard" class="self-start px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Dashboard
        </a>
    </div>

    <!-- Alert Banners dengan Auto-Dismiss & Tombol Tutup -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div id="alert-banner-error" class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-600 text-xs flex items-center justify-between gap-3 shadow-sm transition-all duration-500">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-triangle-exclamation text-base shrink-0"></i>
                <span class="font-bold"><%= error %></span>
            </div>
            <button type="button" onclick="dismissAlert('alert-banner-error')" class="text-rose-500 hover:text-rose-700 p-1">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div id="alert-banner-success" class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 text-xs flex items-center justify-between gap-3 shadow-sm transition-all duration-500">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-circle-check text-base shrink-0"></i>
                <span class="font-bold"><%= success %></span>
            </div>
            <button type="button" onclick="dismissAlert('alert-banner-success')" class="text-emerald-600 hover:text-emerald-800 p-1">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>
    <% } %>

    <!-- Form Pengajuan 3 Judul Baru -->
    <form action="/mahasiswa/pengajuan-judul" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 space-y-8 shadow-xl">
        <div class="border-b border-slate-200 pb-4">
            <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-book-bookmark text-blue-700"></i> Form Usulan 3 Judul Tugas Akhir / Skripsi
            </h3>
            <p class="text-xs text-slate-500 mt-1">Anda wajib mengisikan 3 usulan judul yang berbeda beserta abstraksi, tujuan, dan manfaat untuk setiap usulan.</p>
        </div>

        <!-- USULAN JUDUL 1 -->
        <div class="bg-slate-50/80 border border-blue-200 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 text-blue-800 font-extrabold text-sm border-b border-blue-100 pb-2">
                <span class="px-2.5 py-0.5 bg-blue-700 text-white rounded-lg text-xs font-black">1</span>
                <span>Usulan Judul Utama (Judul 1) *</span>
            </div>
            <div>
                <label for="judul_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Rencana Judul 1 *</label>
                <textarea id="judul_1" name="judul_1" rows="2" required placeholder="Contoh: Rancang Bangun Sistem E-Surat Administrasi Berbasis Microservices pada UNIDAYAN"
                    class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-blue-600 text-xs font-bold text-slate-900 transition"></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="abstraksi_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Abstraksi & Rumusan Masalah 1 *</label>
                    <textarea id="abstraksi_1" name="abstraksi_1" rows="3" required placeholder="Abstraksi singkat dan latar belakang masalah..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                </div>
                <div>
                    <label for="tujuan_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Tujuan Penelitian 1 *</label>
                    <textarea id="tujuan_1" name="tujuan_1" rows="3" required placeholder="Tujuan yang ingin dicapai dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                </div>
                <div>
                    <label for="manfaat_1" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Manfaat Penelitian 1 *</label>
                    <textarea id="manfaat_1" name="manfaat_1" rows="3" required placeholder="Manfaat praktis dan akademis dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600"></textarea>
                </div>
            </div>
        </div>

        <!-- USULAN JUDUL 2 -->
        <div class="bg-slate-50/80 border border-emerald-200 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 text-emerald-800 font-extrabold text-sm border-b border-emerald-100 pb-2">
                <span class="px-2.5 py-0.5 bg-emerald-700 text-white rounded-lg text-xs font-black">2</span>
                <span>Usulan Judul Alternatif (Judul 2) *</span>
            </div>
            <div>
                <label for="judul_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Rencana Judul 2 *</label>
                <textarea id="judul_2" name="judul_2" rows="2" required placeholder="Contoh: Analisis Sentimen Opini Publik Menggunakan Algoritma Support Vector Machine"
                    class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-emerald-600 text-xs font-bold text-slate-900 transition"></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="abstraksi_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Abstraksi & Rumusan Masalah 2 *</label>
                    <textarea id="abstraksi_2" name="abstraksi_2" rows="3" required placeholder="Abstraksi singkat dan latar belakang masalah..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-emerald-600"></textarea>
                </div>
                <div>
                    <label for="tujuan_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Tujuan Penelitian 2 *</label>
                    <textarea id="tujuan_2" name="tujuan_2" rows="3" required placeholder="Tujuan yang ingin dicapai dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-emerald-600"></textarea>
                </div>
                <div>
                    <label for="manfaat_2" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Manfaat Penelitian 2 *</label>
                    <textarea id="manfaat_2" name="manfaat_2" rows="3" required placeholder="Manfaat praktis dan akademis dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-emerald-600"></textarea>
                </div>
            </div>
        </div>

        <!-- USULAN JUDUL 3 -->
        <div class="bg-slate-50/80 border border-purple-200 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex items-center gap-2 text-purple-800 font-extrabold text-sm border-b border-purple-100 pb-2">
                <span class="px-2.5 py-0.5 bg-purple-700 text-white rounded-lg text-xs font-black">3</span>
                <span>Usulan Judul Cadangan (Judul 3) *</span>
            </div>
            <div>
                <label for="judul_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Rencana Judul 3 *</label>
                <textarea id="judul_3" name="judul_3" rows="2" required placeholder="Contoh: Penerapan Internet of Things (IoT) pada Monitoring Kualitas Air Tambak Garam"
                    class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl focus:outline-none focus:border-purple-600 text-xs font-bold text-slate-900 transition"></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label for="abstraksi_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Abstraksi & Rumusan Masalah 3 *</label>
                    <textarea id="abstraksi_3" name="abstraksi_3" rows="3" required placeholder="Abstraksi singkat dan latar belakang masalah..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600"></textarea>
                </div>
                <div>
                    <label for="tujuan_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Tujuan Penelitian 3 *</label>
                    <textarea id="tujuan_3" name="tujuan_3" rows="3" required placeholder="Tujuan yang ingin dicapai dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600"></textarea>
                </div>
                <div>
                    <label for="manfaat_3" class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1">Manfaat Penelitian 3 *</label>
                    <textarea id="manfaat_3" name="manfaat_3" rows="3" required placeholder="Manfaat praktis dan akademis dari judul ini..."
                        class="w-full px-3 py-2 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600"></textarea>
                </div>
            </div>
        </div>

        <!-- Informational Banner for Dosen Pembimbing Assignment -->
        <div class="p-5 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl flex items-start gap-3 text-xs text-blue-900 shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">
                <i class="fa-solid fa-user-gear"></i>
            </div>
            <div>
                <h4 class="font-extrabold text-blue-900 uppercase tracking-wider text-[11px]">Penetapan Dosen Pembimbing Oleh Program Studi</h4>
                <p class="mt-1 font-medium leading-relaxed text-blue-800">
                    Sesuai kebijakan akademik, Mahasiswa tidak memilih Dosen Pembimbing sendiri. Dosen Pembimbing Utama (Pembimbing I) dan Pendamping (Pembimbing II) akan ditentukan secara resmi oleh Kaprodi / Sekprodi / Admin setelah hasil verifikasi 3 usulan judul Anda disetujui.
                </p>
            </div>
        </div>

        <!-- Berkas Proposal PDF -->
        <div>
            <label for="file_proposal" class="block text-xs font-extrabold text-slate-800 uppercase tracking-wider mb-2">Upload Draft Proposal Skripsi / Outline Penelitian (PDF)</label>
            <div class="p-4 border-2 border-dashed border-slate-300 rounded-2xl bg-slate-50 text-center hover:border-blue-500 transition">
                <input type="file" id="file_proposal" name="file_proposal" accept=".pdf" class="text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-700 file:text-white cursor-pointer">
            </div>
        </div>

        <button type="submit" class="w-full py-3.5 px-4 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 text-white font-extrabold rounded-xl text-xs shadow-lg transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane text-amber-400"></i> Kirim Usulan 3 Judul TA
        </button>
    </form>

    <!-- Riwayat Status Pengajuan Judul (Tampilan Sistematis & Timeline) -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center text-base font-bold shadow-sm">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <h3 class="text-base font-extrabold text-slate-900">Riwayat Status Pengajuan Judul Saya</h3>
                    <p class="text-xs text-slate-500">Pantau proses pemeriksaan dan persetujuan 3 usulan judul Tugas Akhir Anda.</p>
                </div>
            </div>
            <% if (listJudul && listJudul.length > 0) { %>
                <span class="text-xs font-bold px-3 py-1 bg-slate-100 text-slate-700 rounded-full border border-slate-200">
                    Total <%= listJudul.length %> Pengajuan
                </span>
            <% } %>
        </div>

        <% if (listJudul && listJudul.length > 0) { %>
            <div class="space-y-6">
                <% listJudul.forEach((item, index) => { 
                    const isPending = item.status === 'pending_tu' || item.status === 'pending_sekprodi' || item.status === 'pending_kaprodi';
                    const isApproved = item.status === 'diterima';
                    const isRejected = item.status === 'ditolak';
                    const isRevisi = item.status === 'revisi';
                %>
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-5 shadow-sm transition hover:shadow-md">
                        <!-- Top Header Row -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200/80 pb-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-1 rounded-lg text-xs font-black bg-slate-900 text-white">#<%= listJudul.length - index %></span>
                                <span class="text-xs font-bold text-slate-600">
                                    <i class="fa-solid fa-calendar-day mr-1 text-slate-400"></i>
                                    <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                </span>
                            </div>

                            <div>
                                <% if (isPending) { %>
                                    <span class="px-3 py-1.5 rounded-full bg-blue-100 border border-blue-300 text-blue-800 text-xs font-extrabold flex items-center gap-1.5 shadow-sm">
                                        <i class="fa-solid fa-spinner fa-spin text-blue-600"></i> Proses Pemeriksaan
                                    </span>
                                <% } else if (isApproved) { %>
                                    <span class="px-3 py-1.5 rounded-full bg-emerald-600 text-white text-xs font-black flex items-center gap-1.5 shadow-sm">
                                        <i class="fa-solid fa-circle-check"></i> DITERIMA (ACC)
                                    </span>
                                <% } else if (isRevisi) { %>
                                    <span class="px-3 py-1.5 rounded-full bg-amber-500 text-slate-950 text-xs font-black flex items-center gap-1.5 shadow-sm">
                                        <i class="fa-solid fa-pen-to-square"></i> PERLU REVISI
                                    </span>
                                <% } else { %>
                                    <span class="px-3 py-1.5 rounded-full bg-rose-600 text-white text-xs font-black flex items-center gap-1.5 shadow-sm">
                                        <i class="fa-solid fa-circle-xmark"></i> DITOLAK
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Workflow Step Tracker -->
                        <div class="grid grid-cols-3 gap-2 bg-white rounded-xl p-3 border border-slate-200 text-center">
                            <div class="space-y-1">
                                <div class="w-6 h-6 mx-auto rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-extrabold">
                                    <i class="fa-solid fa-check"></i>
                                </div>
                                <p class="text-[10px] font-bold text-slate-700">1. Usulan Dikirim</p>
                            </div>

                            <div class="space-y-1">
                                <div class="w-6 h-6 mx-auto rounded-full <%= isApproved ? 'bg-emerald-500 text-white' : (isPending ? 'bg-blue-600 text-white animate-pulse' : 'bg-slate-300 text-slate-600') %> flex items-center justify-center text-[10px] font-extrabold">
                                    <i class="fa-solid <%= isApproved ? 'fa-check' : 'fa-hourglass-half' %>"></i>
                                </div>
                                <p class="text-[10px] font-bold <%= isPending ? 'text-blue-700' : 'text-slate-700' %>">2. Proses Pemeriksaan</p>
                            </div>

                            <div class="space-y-1">
                                <div class="w-6 h-6 mx-auto rounded-full <%= isApproved ? 'bg-emerald-500 text-white' : (isRejected ? 'bg-rose-500 text-white' : 'bg-slate-300 text-slate-600') %> flex items-center justify-center text-[10px] font-extrabold">
                                    <i class="fa-solid <%= isApproved ? 'fa-award' : (isRejected ? 'fa-xmark' : 'fa-flag') %>"></i>
                                </div>
                                <p class="text-[10px] font-bold <%= isApproved ? 'text-emerald-700 font-extrabold' : 'text-slate-700' %>">3. Keputusan ACC</p>
                            </div>
                        </div>

                        <!-- 3 Proposed Titles Grid -->
                        <div class="space-y-2.5">
                            <p class="text-xs font-extrabold text-slate-700 uppercase tracking-wider">3 Usulan Judul Yang Diajukan:</p>

                            <!-- Judul 1 -->
                            <div class="p-3.5 rounded-xl bg-white border <%= isApproved && (item.judul_disetujui_nomor === 1 || !item.judul_disetujui_nomor) ? 'border-emerald-500 ring-2 ring-emerald-500/40 bg-emerald-50/30' : 'border-slate-200' %> transition">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex gap-2">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-blue-100 text-blue-800 border border-blue-200 shrink-0">Judul 1</span>
                                        <p class="text-xs font-bold text-slate-900 leading-relaxed"><%= item.judul_1 || item.judul_ta %></p>
                                    </div>
                                    <% if (isApproved && (item.judul_disetujui_nomor === 1 || !item.judul_disetujui_nomor)) { %>
                                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-600 text-white border border-emerald-700 shrink-0">
                                            <i class="fa-solid fa-circle-check mr-1"></i> JUDUL DI-ACC
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Judul 2 -->
                            <% if (item.judul_2) { %>
                                <div class="p-3.5 rounded-xl bg-white border <%= isApproved && item.judul_disetujui_nomor === 2 ? 'border-emerald-500 ring-2 ring-emerald-500/40 bg-emerald-50/30' : 'border-slate-200' %> transition">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex gap-2">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-200 shrink-0">Judul 2</span>
                                            <p class="text-xs font-bold text-slate-900 leading-relaxed"><%= item.judul_2 %></p>
                                        </div>
                                        <% if (isApproved && item.judul_disetujui_nomor === 2) { %>
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-600 text-white border border-emerald-700 shrink-0">
                                                <i class="fa-solid fa-circle-check mr-1"></i> JUDUL DI-ACC
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Judul 3 -->
                            <% if (item.judul_3) { %>
                                <div class="p-3.5 rounded-xl bg-white border <%= isApproved && item.judul_disetujui_nomor === 3 ? 'border-emerald-500 ring-2 ring-emerald-500/40 bg-emerald-50/30' : 'border-slate-200' %> transition">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="flex gap-2">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-purple-100 text-purple-800 border border-purple-200 shrink-0">Judul 3</span>
                                            <p class="text-xs font-bold text-slate-900 leading-relaxed"><%= item.judul_3 %></p>
                                        </div>
                                        <% if (isApproved && item.judul_disetujui_nomor === 3) { %>
                                            <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-600 text-white border border-emerald-700 shrink-0">
                                                <i class="fa-solid fa-circle-check mr-1"></i> JUDUL DI-ACC
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- Proposed Lecturers Status Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                            <!-- Pembimbing 1 -->
                            <div class="p-3 rounded-xl bg-white border border-slate-200 flex items-center justify-between text-xs">
                                <div>
                                    <span class="text-[10px] font-bold text-slate-400 block uppercase">Dosen Pembimbing 1</span>
                                    <span class="font-bold text-slate-900"><%= item.pembimbing_1_nama || 'Belum Ditentukan (Oleh Prodi)' %></span>
                                </div>
                                <% if (item.pembimbing_1_status === 'bersedia') { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-[10px] font-extrabold border border-emerald-300">BERSEDIA</span>
                                <% } else if (item.pembimbing_1_status === 'menolak') { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-rose-100 text-rose-800 text-[10px] font-extrabold border border-rose-300">MENOLAK</span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 text-[10px] font-extrabold border border-amber-200">PROSES</span>
                                <% } %>
                            </div>

                            <!-- Pembimbing 2 -->
                            <div class="p-3 rounded-xl bg-white border border-slate-200 flex items-center justify-between text-xs">
                                <div>
                                    <span class="text-[10px] font-bold text-slate-400 block uppercase">Dosen Pembimbing 2</span>
                                    <span class="font-bold text-slate-900"><%= item.pembimbing_2_nama || 'Belum Ditentukan (Oleh Prodi)' %></span>
                                </div>
                                <% if (item.pembimbing_2_status === 'bersedia') { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-[10px] font-extrabold border border-emerald-300">BERSEDIA</span>
                                <% } else if (item.pembimbing_2_status === 'menolak') { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-rose-100 text-rose-800 text-[10px] font-extrabold border border-rose-300">MENOLAK</span>
                                <% } else { %>
                                    <span class="px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 text-[10px] font-extrabold border border-amber-200">PROSES</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Feedback / Notes Card (If Any) -->
                        <% if (item.catatan_kaprodi || item.catatan_sekprodi || item.catatan_tu) { %>
                            <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-xs space-y-1">
                                <span class="font-extrabold text-amber-800 flex items-center gap-1">
                                    <i class="fa-solid fa-comment-dots"></i> Catatan & Feedback Pemeriksa:
                                </span>
                                <p class="text-slate-800 font-medium leading-relaxed">
                                    <%= item.catatan_kaprodi || item.catatan_sekprodi || item.catatan_tu %>
                                </p>
                            </div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-300">
                <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-2"></i>
                <p class="text-xs text-slate-600 font-bold">Belum ada pengajuan judul TA.</p>
                <p class="text-[11px] text-slate-400 mt-0.5">Gunakan formulir di atas untuk mengisi 3 usulan judul Tugas Akhir Anda.</p>
            </div>
        <% } %>
    </div>
</div>

<script>
    function dismissAlert(alertId) {
        const el = typeof alertId === 'string' ? document.getElementById(alertId) : alertId;
        if (el) {
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 400);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Auto dismiss alert after 4 seconds
        setTimeout(() => {
            const errorAlert = document.getElementById('alert-banner-error');
            const successAlert = document.getElementById('alert-banner-success');
            if (errorAlert) dismissAlert(errorAlert);
            if (successAlert) dismissAlert(successAlert);
        }, 4000);

        // Clear ?success=... and ?error=... query params from browser URL bar without reloading
        if (window.location.search.includes('success') || window.location.search.includes('error')) {
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
        }
    });
</script>
