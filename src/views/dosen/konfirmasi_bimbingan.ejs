<div class="max-w-6xl mx-auto space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 mb-2">
                <i class="fa-solid fa-book-bookmark"></i> Monitoring Akademik Dosen
            </span>
            <h2 class="text-xl font-extrabold text-slate-900">Daftar Pengajuan Judul Mahasiswa</h2>
            <p class="text-xs text-slate-500 mt-1">Daftar seluruh mahasiswa yang mengajukan permohonan verifikasi judul Tugas Akhir/Skripsi (Tampilan Informasi Dosen).</p>
        </div>
        <a href="/dashboard" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded-xl transition shadow-sm flex items-center gap-1.5">
            <i class="fa-solid fa-arrow-left"></i> Kembali
        </a>
    </div>

    <!-- Main Container -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-xl space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-4">
            <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-list-check text-blue-600"></i> Pengajuan Judul Tugas Akhir / Skripsi
            </h3>
            <span class="text-xs font-bold text-slate-500">
                Total Pengajuan: <span class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 font-black"><%= proposals ? proposals.length : 0 %></span>
            </span>
        </div>

        <% if (proposals && proposals.length > 0) { %>
            <div class="space-y-4">
                <% proposals.forEach(p => { 
                    let statusBadgeClass = 'bg-slate-100 text-slate-700 border-slate-300';
                    let statusLabel = p.status ? p.status.toUpperCase() : 'PROSES';
                    let statusIcon = 'fa-clock';

                    if (p.status === 'pending_tu') {
                        statusBadgeClass = 'bg-amber-100 text-amber-900 border-amber-300';
                        statusLabel = 'Proses Pemeriksaan';
                        statusIcon = 'fa-spinner fa-spin';
                    } else if (p.status === 'diterima') {
                        statusBadgeClass = 'bg-emerald-100 text-emerald-900 border-emerald-300';
                        statusLabel = 'Disetujui';
                        statusIcon = 'fa-circle-check';
                    } else if (p.status === 'revisi') {
                        statusBadgeClass = 'bg-orange-100 text-orange-900 border-orange-300';
                        statusLabel = 'Perlu Revisi';
                        statusIcon = 'fa-pen-to-square';
                    } else if (p.status === 'ditolak') {
                        statusBadgeClass = 'bg-rose-100 text-rose-900 border-rose-300';
                        statusLabel = 'Ditolak';
                        statusIcon = 'fa-circle-xmark';
                    }
                %>
                    <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition space-y-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 pb-3">
                            <div>
                                <span class="font-extrabold text-sm text-slate-900"><%= p.mhs_nama %></span>
                                <span class="text-xs text-blue-600 font-mono font-bold ml-2">NIM: <%= p.nim %></span>
                            </div>
                            <div>
                                <span class="px-3 py-1 rounded-full text-xs font-black border flex items-center gap-1.5 <%= statusBadgeClass %>">
                                    <i class="fa-solid <%= statusIcon %>"></i> <%= statusLabel %>
                                </span>
                            </div>
                        </div>

                        <div class="space-y-2 text-xs text-slate-800">
                            <div>
                                <span class="text-[10px] font-extrabold uppercase text-slate-400 block tracking-wider">Judul Tugas Akhir Disetujui / Diajukan:</span>
                                <p class="font-extrabold text-slate-900 text-sm mt-0.5"><%= p.judul_ta || p.judul_1 || 'Belum Ada Judul' %></p>
                            </div>

                            <% if (p.abstraksi_1 || p.abstrak_rumusan) { %>
                                <div class="pt-1">
                                    <span class="text-[10px] font-extrabold uppercase text-slate-400 block tracking-wider">Ringkasan / Abstrak:</span>
                                    <p class="text-slate-600 mt-0.5 leading-relaxed bg-white p-3 rounded-xl border border-slate-200"><%= p.abstrak_rumusan || p.abstraksi_1 %></p>
                                </div>
                            <% } %>

                            <div class="pt-2 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-t border-slate-200/60 text-slate-600">
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                                    <span><strong class="text-slate-900">Pembimbing I:</strong> <%= p.pembimbing_1_nama || '-' %></span>
                                    <span><strong class="text-slate-900">Pembimbing II:</strong> <%= p.pembimbing_2_nama || '-' %></span>
                                </div>
                                <% if (p.file_proposal_url) { %>
                                    <a href="<%= p.file_proposal_url %>" target="_blank" class="px-3 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 rounded-lg font-bold text-[11px] transition flex items-center gap-1">
                                        <i class="fa-solid fa-file-pdf text-rose-500"></i> Unduh Berkas Proposal
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="p-12 text-center text-slate-400 bg-slate-50 rounded-2xl border border-slate-200">
                <i class="fa-solid fa-folder-open text-4xl mb-3 text-slate-300"></i>
                <p class="text-xs font-semibold text-slate-600">Belum ada pengajuan judul mahasiswa yang terdaftar di sistem.</p>
            </div>
        <% } %>
    </div>
</div>
