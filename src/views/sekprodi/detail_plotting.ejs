<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-white">Form Ploting Dosen & Validasi Sekprodi</h2>
            <p class="text-xs text-slate-400 mt-1">Mahasiswa: <span class="text-white font-bold"><%= pengajuan.mhs_nama %></span> (NIM: <%= pengajuan.mhs_nim %>)</p>
        </div>
        <a href="/sekprodi/dashboard" class="px-4 py-2 bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-300 text-xs font-semibold rounded-xl transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
        </a>
    </div>

    <!-- Main Form -->
    <form action="/sekprodi/plotting/<%= pengajuan.id %>" method="POST" class="bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-xl space-y-6">
        <!-- SK Dekan Numbering -->
        <div>
            <label for="sk_dekan_nomor" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Nomor SK Dekan / SK Pembimbing TA</label>
            <input type="text" id="sk_dekan_nomor" name="sk_dekan_nomor" value="<%= plotting ? (plotting.sk_dekan_nomor || '') : 'SK-DEKAN/2026/089' %>" placeholder="Contoh: SK-DEKAN/2026/089"
                class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl focus:outline-none focus:border-indigo-500 text-sm text-slate-100 placeholder-slate-500 transition">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            <!-- Tim Dosen Pembimbing -->
            <div class="space-y-4 bg-slate-950/40 p-5 rounded-2xl border border-slate-800">
                <h4 class="text-xs font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-chalkboard-user"></i> Tim Dosen Pembimbing Skripsi (2 Dosen)
                </h4>

                <div>
                    <label for="dosen_pembimbing_1_id" class="block text-xs font-semibold text-slate-300 mb-1">Dosen Pembimbing 1 (Utama) *</label>
                    <select id="dosen_pembimbing_1_id" name="dosen_pembimbing_1_id" required class="w-full px-3 py-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-white">
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (plotting && plotting.dosen_pembimbing_1_id === d.id) ? 'selected' : '' %>><%= d.nama_dosen %> (<%= d.nip_nidn %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label for="dosen_pembimbing_2_id" class="block text-xs font-semibold text-slate-300 mb-1">Dosen Pembimbing 2 (Pendamping) *</label>
                    <select id="dosen_pembimbing_2_id" name="dosen_pembimbing_2_id" required class="w-full px-3 py-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-white">
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (plotting && plotting.dosen_pembimbing_2_id === d.id) ? 'selected' : '' %>><%= d.nama_dosen %> (<%= d.nip_nidn %>)</option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <!-- Tim Dosen Penguji -->
            <div class="space-y-4 bg-slate-950/40 p-5 rounded-2xl border border-slate-800">
                <h4 class="text-xs font-bold text-purple-400 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-user-graduate"></i> Tim Dosen Penguji Sidang (3 Dosen)
                </h4>

                <div>
                    <label for="dosen_penguji_1_id" class="block text-xs font-semibold text-slate-300 mb-1">Dosen Penguji 1 (Ketua Penguji)</label>
                    <select id="dosen_penguji_1_id" name="dosen_penguji_1_id" class="w-full px-3 py-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-white">
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (plotting && plotting.dosen_penguji_1_id === d.id) ? 'selected' : '' %>><%= d.nama_dosen %> (<%= d.nip_nidn %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label for="dosen_penguji_2_id" class="block text-xs font-semibold text-slate-300 mb-1">Dosen Penguji 2 (Penguji Anggota 1)</label>
                    <select id="dosen_penguji_2_id" name="dosen_penguji_2_id" class="w-full px-3 py-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-white">
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (plotting && plotting.dosen_penguji_2_id === d.id) ? 'selected' : '' %>><%= d.nama_dosen %> (<%= d.nip_nidn %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label for="dosen_penguji_3_id" class="block text-xs font-semibold text-slate-300 mb-1">Dosen Penguji 3 (Penguji Anggota 2)</label>
                    <select id="dosen_penguji_3_id" name="dosen_penguji_3_id" class="w-full px-3 py-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-white">
                        <% dosenList.forEach(d => { %>
                            <option value="<%= d.id %>" <%= (plotting && plotting.dosen_penguji_3_id === d.id) ? 'selected' : '' %>><%= d.nama_dosen %> (<%= d.nip_nidn %>)</option>
                        <% }); %>
                    </select>
                </div>
            </div>
        </div>

        <div>
            <label for="catatan_sekprodi" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Catatan Validasi Sekprodi</label>
            <textarea id="catatan_sekprodi" name="catatan_sekprodi" rows="2" placeholder="Catatan verifikasi administrasi..."
                class="w-full px-4 py-3 bg-slate-950/60 border border-slate-800 rounded-xl text-xs text-slate-100 placeholder-slate-500"></textarea>
        </div>

        <div class="flex items-center gap-3 pt-2">
            <button type="submit" name="action" value="verify" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-blue-600/30 flex items-center gap-2">
                <i class="fa-solid fa-check-circle"></i> Simpan Ploting & Diteruskan ke Kaprodi
            </button>
            <button type="submit" name="action" value="reject" class="px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-xl text-xs transition shadow-lg shadow-red-600/30 flex items-center gap-2">
                <i class="fa-solid fa-xmark"></i> Tolak
            </button>
        </div>
    </form>
</div>
